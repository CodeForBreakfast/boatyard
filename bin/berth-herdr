#!/usr/bin/env bash
# berth-herdr: berth's adapter for herdr, which `berth` runs with the verbs
# already parsed. See docs/design.md, "The herdr adapter".
#
# A berth is a herdr pane, and its id is herdr's pane id. A yard is a herdr
# session. The relationship and the opener live on the pane as metadata
# tokens, so herdr itself is the only record.
#
# Needs: bash, coreutils, herdr, jq.
set -euo pipefail

yard=${BERTH_YARD:-${HERDR_SESSION:-default}}
berth_env=(--env BERTH_BACKEND=herdr --env "BERTH_YARD=$yard")

# A split never leaves either half of a pane under min_rows.
min_rows=12
divider_rows=2

die() {
  echo "berth (herdr): $1" >&2
  exit 1
}

# Returns 3 for a pane herdr does not have, so a caller can answer gone.
# Anything else that fails ends berth.
herdr_failed() { # <herdr's output> <herdr arguments>...
  local out=$1 code message
  shift
  code=$(jq -r '.error.code? // empty' <<<"$out" 2>/dev/null) || code=""
  [ "$code" != pane_not_found ] || return 3
  message=$(jq -r '.error.message? // empty' <<<"$out" 2>/dev/null) || message=""
  die "herdr $1 $2 failed in yard $yard: ${message:-$out}"
}

# Prints what a herdr call against the yard prints. An inherited
# HERDR_SOCKET_PATH names the caller's session, which must not override the
# yard.
herdr_call() {
  local out status=0
  out=$(env -u HERDR_SOCKET_PATH herdr --session "$yard" "$@" 2>&1) || status=$?
  if [ "$status" != 0 ]; then
    herdr_failed "$out" "$@"
    return
  fi
  printf '%s\n' "$out"
}

# Prints the result of a herdr call that answers in JSON.
herdr_result() {
  local out
  out=$(herdr_call "$@") || return
  if jq -e '.error? // empty' <<<"$out" >/dev/null 2>&1; then
    herdr_failed "$out" "$@"
    return
  fi
  [ -z "$out" ] || jq -c '.result // empty' <<<"$out" 2>/dev/null ||
    die "herdr $1 $2 answered with something other than JSON: $out"
}

# Runs a call on a berth that has to exist for the verb to go on.
on_berth() { # <id> <what the verb could not do> <call>...
  local id=$1 what=$2 status=0
  shift 2
  "$@" || status=$?
  case $status in
    0) ;;
    3) die "the berth $id is gone, so $what." ;;
    *) exit "$status" ;;
  esac
}

pane_get() {
  local result
  result=$(herdr_result pane get "$1") || return
  jq -c .pane <<<"$result"
}

existing_pane() { # <id> <what the verb could not do>
  on_berth "$1" "$2" pane_get "$1"
}

# The given berth, or the calling pane.
berth_id() {
  local id=${1:-${HERDR_PANE_ID:-}}
  [ -n "$id" ] || die "no berth was given, and the caller is not a berth."
  printf '%s\n' "$id"
}

port_state='
  # ponytail: a straight mapping of herdr states, without the corrections the
  # spec asks for. A pane parked on background work reads active, and so does
  # an agent herdr cannot classify.
  def port_state:
    if .agent == null then "gone"
    elif .agent_status == "blocked" then "blocked"
    elif .agent_status == "idle" or .agent_status == "done" then "at-rest"
    else "active" end;'

# Splits the tallest of the given panes: down while both halves clear
# min_rows, otherwise right. Prints the new pane's id.
split_tallest() { # <cwd> <panes as a JSON array>
  local target
  target=$(jq -r --argjson floor "$min_rows" --argjson divider "$divider_rows" '
    sort_by(.scroll.viewport_rows) | last
    | "\(.pane_id) \(if (.scroll.viewport_rows - $divider) / 2 | floor >= $floor
                     then "down" else "right" end)"' <<<"$2")
  herdr_result pane split "${target% *}" --direction "${target#* }" --cwd "$1" \
    "${berth_env[@]}" --no-focus | jq -r .pane.pane_id
}

open() {
  local as=$1 cwd=$2 label=$3 opener=$4 id opener_pane workspace panes tab
  shift 4

  if [ "$as" = independent ]; then
    # It starts its own line of work, so its opener is not its parent.
    opener=""
    id=$(herdr_result workspace create --cwd "$cwd" ${label:+--label "$label"} \
      "${berth_env[@]}" --no-focus | jq -r .root_pane.pane_id)
  else
    opener=$(berth_id "$opener")
    opener_pane=$(existing_pane "$opener" "there is nothing to open a $as beside")
    workspace=$(jq -r .workspace_id <<<"$opener_pane")

    if [ "$as" = tender ]; then
      id=$(split_tallest "$cwd" "[$opener_pane]")
    else
      # One tab holds an opener's workers.
      panes=$(herdr_result pane list --workspace "$workspace")
      tab=$(jq -r --arg opener "$opener" '
        first(.panes[] | select(.tokens.berth_parent == $opener
                                and .tokens.berth_relationship == "worker"))
        | .tab_id' <<<"$panes")
      if [ -n "$tab" ]; then
        id=$(split_tallest "$cwd" "$(jq -c --arg tab "$tab" '[.panes[] | select(.tab_id == $tab)]' <<<"$panes")")
      else
        id=$(herdr_result tab create --workspace "$workspace" --cwd "$cwd" --label workers \
          "${berth_env[@]}" --no-focus | jq -r .root_pane.pane_id)
      fi
    fi
  fi

  [ -z "$label" ] || herdr_result pane rename "$id" "$label" >/dev/null
  herdr_result pane report-metadata "$id" --source berth --token "berth_relationship=$as" \
    ${opener:+--token "berth_parent=$opener"} >/dev/null

  # herdr gives a pane its id only once it exists, so BERTH_ID reaches the
  # command rather than the pane's shell.
  local command
  printf -v command '%q ' "$@"
  herdr_result pane run "$id" "env BERTH_ID=$(printf '%q' "$id") $command" >/dev/null

  printf '%s\n' "$id"
}

name() {
  local id pane
  id=$(berth_id "$1")
  pane=$(existing_pane "$id" "it cannot be named")
  herdr_result pane rename "$id" "$2" >/dev/null
  if [ "$(jq -r '.tokens.berth_relationship // empty' <<<"$pane")" = independent ]; then
    herdr_result workspace rename "$(jq -r .workspace_id <<<"$pane")" "$2" >/dev/null
  fi
}

yard_running() {
  env -u HERDR_SOCKET_PATH herdr --session "$yard" status server --json | jq -e .running >/dev/null
}

serve() {
  yard=$1
  ! yard_running || die "the yard $yard is already being served."
  exec env -u HERDR_SOCKET_PATH herdr --session "$yard" server
}

stop() {
  yard=$1
  yard_running || return 0
  herdr_call server stop >/dev/null
}

send_text() {
  local id
  id=$(berth_id "$1")
  on_berth "$id" "it cannot take text" herdr_result pane send-text "$id" "$2" >/dev/null
}

send_key() {
  local id
  id=$(berth_id "$1")
  on_berth "$id" "it cannot take a key" herdr_result pane send-keys "$id" "$2" >/dev/null
}

# herdr searches about two screens of recent output unless told more, which
# a long enough line outgrows.
recent_lines=1000

# Matches the unwrapped output, so a line that wraps past the pane's height
# still matches whole.
wait_text() {
  local id
  id=$(berth_id "$1")
  on_berth "$id" "there is nothing to wait on" herdr_result pane wait-output "$id" \
    --match "$2" --source recent-unwrapped --lines "$recent_lines" --timeout "$(($3 * 1000))" >/dev/null
}

read_screen() {
  local id
  id=$(berth_id "$1")
  on_berth "$id" "it cannot be read" herdr_call pane read "$id" --source visible --format text
}

list() {
  yard=${1:-$yard}
  herdr_result pane list | jq "$port_state"'
    [.panes[] | select(.tokens.berth_relationship) | {
      id: .pane_id,
      label: (.label // null),
      relationship: .tokens.berth_relationship,
      parent: (.tokens.berth_parent // null),
      state: port_state
    }]'
}

state() {
  local id pane status=0
  id=$(berth_id "$1")
  pane=$(pane_get "$id") || status=$?
  case $status in
    0) jq -r "$port_state port_state" <<<"$pane" ;;
    3) echo gone ;;
    *) exit "$status" ;;
  esac
}

# Closing a berth closes the berths it opened first. herdr keeps a
# workspace's other panes when its first pane closes, so an independent berth
# closes its whole workspace.
close() {
  local id pane panes child status=0
  id=$(berth_id "$1")
  pane=$(pane_get "$id") || status=$?
  case $status in
    0) ;;
    3) return 0 ;;
    *) exit "$status" ;;
  esac

  panes=$(herdr_result pane list)
  for child in $(jq -r --arg id "$id" '.panes[] | select(.tokens.berth_parent == $id) | .pane_id' <<<"$panes"); do
    close "$child"
  done

  if [ "$(jq -r '.tokens.berth_relationship // empty' <<<"$pane")" = independent ]; then
    herdr_result workspace close "$(jq -r .workspace_id <<<"$pane")" >/dev/null
  else
    herdr_result pane close "$id" >/dev/null
  fi
}

verb=$1
shift
case "$verb" in
  serve | stop | open | name | list | state | close) "$verb" "$@" ;;
  send-text) send_text "$@" ;;
  send-key) send_key "$@" ;;
  wait-text) wait_text "$@" ;;
  read) read_screen "$@" ;;
  *) die "berth passed an unknown verb, $verb." ;;
esac
