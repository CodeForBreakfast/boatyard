#!/usr/bin/env bash
# bilge-pump-tap: records an agent's free context for bilge-pump, then runs the
# user's own statusline command on the same input. See docs/design.md,
# "bilge-pump".
#
# It is the statusline command, with the user's command as its arguments:
#
#   "statusLine": { "type": "command", "command": "bilge-pump-tap <command>..." }
#
# The figure is Claude Code's context_window.remaining_percentage, kept at
# <state dir>/<yard>/<berth>/context. An input without one removes the record,
# because Claude Code leaves it out straight after a compact. Outside a berth
# it records nothing. Recording never stops the statusline from drawing.
#
# Needs: bash, coreutils, jq.
set -uo pipefail

input=$(mktemp)
cat >"$input"

record() {
  local dir free
  [ -n "${BERTH_YARD:-}" ] && [ -n "${BERTH_ID:-}" ] || return 0
  dir="${BILGE_PUMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/bilge-pump}/$BERTH_YARD/$BERTH_ID"
  free=$(jq -r '.context_window.remaining_percentage // empty | floor' <"$input") || return
  if [ -z "$free" ]; then
    rm -f "$dir/context"
    return
  fi
  mkdir -p "$dir" &&
    printf '%s\n' "$free" >"$dir/.context.tmp" &&
    mv "$dir/.context.tmp" "$dir/context"
}
record 2>/dev/null

exec 3<"$input"
rm -f "$input"
[ $# -gt 0 ] || exit 0
exec "$@" <&3 3<&-
