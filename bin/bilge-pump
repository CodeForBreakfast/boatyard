#!/usr/bin/env bash
# bilge-pump: compacts an agent that is at rest and low on free context. See
# docs/design.md, "bilge-pump".
#
# It runs one long-lived process per berth, detached from its caller. It reads
# the berth's state through `berth state`, and types through `berth send-text`
# and `berth send-key`. The free-context figure is what bilge-pump-tap records
# from the agent's statusline. A berth with no figure is never compacted.
#
# Its files live under <state dir>/<yard>/<berth>/: `context` from the tap,
# `pid` naming the one bilge-pump that runs there, and `heartbeat`, rewritten
# every tick as "<epoch> <state> <free> <threshold> <yard>". The log is
# <state dir>/bilge-pump.log.
#
# Needs: bash, coreutils, perl, berth.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: bilge-pump [<berth>] [--threshold <free %>] [--cooldown <s>] [--tick <s>]

The threshold is --threshold, else $BILGE_PUMP_THRESHOLD, else 70.
EOF
  exit 2
}

die() {
  echo "bilge-pump: $1" >&2
  exit 1
}

berth="" threshold=${BILGE_PUMP_THRESHOLD-70} cooldown=300 tick=60
while [ $# -gt 0 ]; do
  case "$1" in
    --threshold) threshold=${2:-}; shift 2 || usage ;;
    --cooldown) cooldown=${2:-}; shift 2 || usage ;;
    --tick) tick=${2:-}; shift 2 || usage ;;
    -*) usage ;;
    *)
      [ -z "$berth" ] || usage
      berth=$1
      shift
      ;;
  esac
done
for number in "$threshold" "$cooldown" "$tick"; do
  case "$number" in '' | *[!0-9]*) usage ;; esac
done

command -v berth >/dev/null ||
  die "berth is not on the path, and bilge-pump reads and types through it."
berth=${berth:-${BERTH_ID:-}}
[ -n "$berth" ] || die "no berth was given, and the caller is not a berth."
yard=${BERTH_YARD:-}
[ -n "$yard" ] || die "BERTH_YARD is not set, so there is no yard to keep berth $berth's files under."

here=$(dirname "$(readlink -f "$0")")
root=${BILGE_PUMP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/bilge-pump}
dir="$root/$yard/$berth"
log_file="$root/bilge-pump.log"

log() { # <what> [<detail>]
  printf '%s %s %s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$yard" "$berth" "$1" "${2:--}" \
    >>"$log_file"
}

# How long a berth may stay gone before its agent first shows, because
# sign-on attaches before the agent has started.
arrival_timeout=600

pump() {
  # A failed call is the backend restarting or busy, so the loop goes on. A
  # heartbeat that stops changing is what shows it.
  set +e
  local state free decision now started last_fire=0 seen=0 announced=0
  started=$(date +%s)
  log start "threshold=$threshold"

  while true; do
    now=$(date +%s)
    if state=$(berth state "$berth"); then
      if [ "$state" = gone ]; then
        if [ "$seen" = 1 ] || [ $((now - started)) -ge "$arrival_timeout" ]; then
          log reap
          rm -f "$dir/heartbeat" "$dir/context" "$dir/pid"
          rmdir "$dir" 2>/dev/null
          exit 0
        fi
      else
        seen=1
      fi

      free=$(cat "$dir/context" 2>/dev/null) || free=""
      if [ -z "$free" ] && [ "$seen" = 1 ] && [ "$announced" = 0 ]; then
        log no-figure "left to Claude Code's own auto-compact"
        announced=1
      fi

      decision=$("$here/bilge-pump-decide" "$state" "$free" $((now - last_fire)) "$threshold" "$cooldown")
      if [ "$decision" = fire ]; then
        # Claude Code's slash-command menu takes the first Enter to accept the
        # highlighted entry, so a second Enter submits it. If the first one
        # already submitted, the second lands on an empty prompt and does
        # nothing.
        if berth send-text "$berth" /compact &&
          berth send-key "$berth" Enter &&
          sleep 1 &&
          berth send-key "$berth" Enter; then
          log fire "free=$free"
        else
          log fire-failed "free=$free"
        fi
        last_fire=$now
      fi

      # Last, so that the file means a tick completed rather than started.
      printf '%s %s %s %s %s\n' "$now" "$state" "${free:--}" "$threshold" "$yard" \
        >"$dir/.heartbeat.tmp" && mv "$dir/.heartbeat.tmp" "$dir/heartbeat"
    fi
    sleep "$tick"
  done
}

if [ "${BILGE_PUMP_DETACHED:-}" = 1 ]; then
  unset BILGE_PUMP_DETACHED
  pump
fi

mkdir -p "$dir"

claim() { (set -o noclobber && echo "$$" >"$dir/pid") 2>/dev/null; }
if ! claim; then
  holder=$(cat "$dir/pid" 2>/dev/null) || holder=""
  # ponytail: a reused pid reads as a live holder, so a stale file can refuse
  # a start until it is removed. Check the holder's command line if that
  # bites.
  if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
    die "one already runs on berth $berth in yard $yard, as process $holder."
  fi
  rm -f "$dir/pid"
  claim || die "another one took berth $berth in yard $yard as this one started."
fi

# The pump runs in a session of its own, so that it outlives its caller and
# the caller's terminal. perl rather than setsid(1), which macOS lacks. The
# fork makes sure the child is not a process group leader, which setsid()
# refuses. The pid file names this process until it names the child, so a
# second start never finds it stale in between.
child=$(BILGE_PUMP_DETACHED=1 perl -MPOSIX -e '
  my $log = shift;
  defined(my $pid = fork) or die "fork: $!\n";
  if ($pid) { print $pid; exit 0 }
  POSIX::setsid() or die "setsid: $!\n";
  open STDIN, "<", "/dev/null";
  open STDOUT, ">", "/dev/null";
  open STDERR, ">>", $log;
  exec @ARGV or die "exec: $!\n";
' "$log_file" "$0" "$berth" --threshold "$threshold" --cooldown "$cooldown" --tick "$tick") ||
  child=""
if [ -z "$child" ]; then
  rm -f "$dir/pid"
  die "could not detach from the caller."
fi
echo "$child" >"$dir/pid"
