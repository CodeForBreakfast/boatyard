#!/usr/bin/env bash
# berth: the backend-neutral port. See docs/design.md, "The port: berth".
#
# This front end reads the arguments and hands each verb to the adapter that
# BERTH_BACKEND names, `berth-<backend>` beside this script. An adapter takes
# the verbs already parsed:
#
#   serve <yard>
#   stop <yard>
#   yard
#   open <independent|worker|tender> <apart|beside|tab> <focus|no-focus> <cwd> <label> <opener> <command>...
#   name <id> <label>
#   list <yard>
#   send-text <id> <text>
#   send-key <id> <key>
#   wait-text <id> <text> <seconds>
#   read <id>
#   state <id>
#   close <id>
#
# serve execs the backend, so that a service manager supervises the real
# process. wait-text matches its text as a literal within one line of recent
# output, and read prints the visible screen as plain text.
#
# <opener> is BERTH_ID, and so is <id> when the caller gave none. Either is
# empty when BERTH_ID is unset too, and the adapter then resolves the calling
# berth from its backend's own variables. <label> and <yard> may be empty.
# <apart|beside|tab> is apart for every berth but an independent one that
# opens next to its opener, or in a view of its own near its opener, rather
# than in a place of its own.
#
# Needs: bash, coreutils, and whatever the adapter needs.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: berth serve <yard>
       berth stop <yard>
       berth yard
       berth open --as independent|worker|tender --cwd <dir> [--label <text>] [--focus]
                  [--beside | --tab] -- <command>...
       berth name [<id>] <label>
       berth list [<yard>]
       berth send-text [<id>] <text>
       berth send-key [<id>] <key>
       berth wait-text [<id>] <text> --timeout <seconds>
       berth read [<id>]
       berth state [<id>]
       berth close [<id>]
EOF
  exit 2
}

die() {
  echo "berth: $1" >&2
  exit 1
}

[ $# -gt 0 ] || usage
verb=$1
shift

[ -n "${BERTH_BACKEND:-}" ] ||
  die "no backend named. Set BERTH_BACKEND, for example to herdr."
adapter="$(dirname "$(readlink -f "$0")")/berth-$BERTH_BACKEND"
[ -x "$adapter" ] || die "there is no adapter for the backend '$BERTH_BACKEND'."

case "$verb" in
  serve | stop)
    [ $# = 1 ] || usage
    exec "$adapter" "$verb" "$1"
    ;;
  open)
    as="" cwd="" label="" focus=no-focus place=apart
    while [ $# -gt 0 ]; do
      case "$1" in
        --as) as=${2:-}; shift 2 || usage ;;
        --cwd) cwd=${2:-}; shift 2 || usage ;;
        --label) label=${2:-}; shift 2 || usage ;;
        --focus) focus=focus; shift ;;
        --beside | --tab)
          [ "$place" = apart ] || usage
          place=${1#--}
          shift
          ;;
        --) shift; break ;;
        *) usage ;;
      esac
    done
    case "$as" in independent | worker | tender) ;; *) usage ;; esac
    [ "$place" = apart ] || [ "$as" = independent ] || usage
    [ -n "$cwd" ] && [ $# -gt 0 ] || usage
    [ -d "$cwd" ] || die "--cwd $cwd is not a directory."
    exec "$adapter" open "$as" "$place" "$focus" "$(cd "$cwd" && pwd)" "$label" "${BERTH_ID:-}" "$@"
    ;;
  name | send-text | send-key)
    case $# in
      1) exec "$adapter" "$verb" "${BERTH_ID:-}" "$1" ;;
      2) exec "$adapter" "$verb" "$1" "$2" ;;
      *) usage ;;
    esac
    ;;
  wait-text)
    timeout="" args=()
    while [ $# -gt 0 ]; do
      case "$1" in
        --timeout) timeout=${2:-}; shift 2 || usage ;;
        *) args+=("$1"); shift ;;
      esac
    done
    [[ $timeout =~ ^[0-9]+$ ]] || usage
    case ${#args[@]} in
      1) exec "$adapter" wait-text "${BERTH_ID:-}" "${args[0]}" "$timeout" ;;
      2) exec "$adapter" wait-text "${args[0]}" "${args[1]}" "$timeout" ;;
      *) usage ;;
    esac
    ;;
  yard)
    [ $# = 0 ] || usage
    exec "$adapter" yard
    ;;
  list)
    [ $# -le 1 ] || usage
    exec "$adapter" list "${1:-}"
    ;;
  read | state | close)
    case $# in
      0) exec "$adapter" "$verb" "${BERTH_ID:-}" ;;
      1) exec "$adapter" "$verb" "$1" ;;
      *) usage ;;
    esac
    ;;
  *) usage ;;
esac
