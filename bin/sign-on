#!/usr/bin/env bash
# sign-on: launches Claude Code in a berth, attaches bilge-pump and gets it past
# its startup gate. See docs/design.md, "sign-on".
#
# The host configures it through the environment:
#
#   SIGN_ON_CLAUDE         the Claude Code command, with any wrapper and flags
#                          baked in. sign-on appends the launch's flags, then
#                          `--` and the prompt if there is one.
#   SIGN_ON_GATE           the startup gate's text. Unset, sign-on waits only
#                          for the agent to show.
#   SIGN_ON_MCP_TIMEOUT    Claude Code's MCP start-up timeout, in milliseconds.
#   SIGN_ON_START_TIMEOUT  how long the agent may take to show its gate, or to
#                          show at all, in seconds.
#   SIGN_ON_MIN_MEMORY     the memory the host must have available for a seat
#                          to start, in GiB. 0 turns the check off.
#
# Needs: bash, coreutils, git, berth, bilge-pump.
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: sign-on --as independent|worker|tender --cwd <dir> [--label <text>]
               [--beside | --tab] [--focus] [--model <model>] [--effort <level>]
               [--add-dir <dir>] [--env <name>=<value>]... [--settings <file>]
               [--threshold <free %>] [<prompt>]

An independent seat starts its own line of work, so it opens apart from its
caller, where the backend keeps a line of work: in herdr, a workspace of its
own. With --beside, it opens beside its caller instead, in herdr a split of
the caller's pane. With --tab, it opens in a view of its own near its caller,
in herdr a new tab in the caller's workspace. Either way it still outlives the
caller. A worker opens beside its opener's other workers, and a tender beside
its opener.

A seat opens without focus, so the person at the screen stays where they are.
With --focus, they land on the seat as soon as it opens, before sign-on gets
it past its startup gate.

With no prompt, the seat takes no turn and waits at its prompt for a person.
EOF
  exit 2
}

die() {
  echo "sign-on: $1" >&2
  exit 1
}

as="" cwd="" label="" place="" focus="" threshold="" prompt=() flags=() env=()
while [ $# -gt 0 ]; do
  case "$1" in
    --as) as=${2:-}; shift 2 || usage ;;
    --cwd) cwd=${2:-}; shift 2 || usage ;;
    --label) label=${2:-}; shift 2 || usage ;;
    --beside | --tab)
      [ -z "$place" ] || usage
      place=$1
      shift
      ;;
    --focus) focus=1; shift ;;
    --model | --effort | --add-dir | --settings)
      [ -n "${2:-}" ] || usage
      flags+=("$1" "$2")
      shift 2
      ;;
    --env)
      [[ ${2:-} =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || usage
      env+=("$2")
      shift 2
      ;;
    --threshold) threshold=${2:-}; shift 2 || usage ;;
    -*) usage ;;
    *)
      [ ${#prompt[@]} -eq 0 ] && [ -n "$1" ] || usage
      prompt=(-- "$1")
      shift
      ;;
  esac
done
[ -n "$as" ] && [ -n "$cwd" ] || usage
[ -z "$place" ] || [ "$as" = independent ] || usage

claude=${SIGN_ON_CLAUDE:-claude}
gate=${SIGN_ON_GATE:-}
start_timeout=${SIGN_ON_START_TIMEOUT:-180}
min_memory=${SIGN_ON_MIN_MEMORY:-8}

# Prints MemAvailable in KiB, or fails where the host has no /proc/meminfo.
available_kib() {
  local key value _
  while read -r key value _; do
    [ "$key" != MemAvailable: ] || { printf '%s\n' "$value" && return 0; }
  done </proc/meminfo
  return 1
} 2>/dev/null

[[ $min_memory =~ ^[0-9]+$ ]] || die "SIGN_ON_MIN_MEMORY is '$min_memory', not a whole number of GiB."
if [ "$min_memory" -gt 0 ]; then
  if available=$(available_kib); then
    if [ "$available" -lt $((min_memory * 1024 * 1024)) ]; then
      echo "sign-on: the host has $((available / 1024 / 1024)) GiB of memory available, below the $min_memory GiB a seat needs. Start the seat once a running one has finished." >&2
      exit 75 # sysexits' EX_TEMPFAIL, so a caller can tell "not now" from a failure.
    fi
  else
    # ponytail: Linux only. macOS would need vm_stat's page counts.
    echo "sign-on: the host does not report its available memory, so the seat starts without the $min_memory GiB check." >&2
  fi
fi

BERTH_YARD=$(berth yard)
export BERTH_YARD

# Claude Code reads its instructions, skills and trust state from the launch
# directory and cannot re-read them after a cd, so a seat is born in the main
# checkout rather than in a linked worktree.
if top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
  main=$(git -C "$cwd" worktree list --porcelain | sed -n '1s/^worktree //p')
  if [ "$top" != "$main" ]; then
    echo "sign-on: $cwd is in a linked worktree, so the seat is born in its main checkout, $main." >&2
    cwd=$main
  fi
fi

command=(env ${SIGN_ON_MCP_TIMEOUT:+"MCP_TIMEOUT=$SIGN_ON_MCP_TIMEOUT"} "${env[@]}" "$claude" "${flags[@]}" "${prompt[@]}")
id=$(berth open --as "$as" ${place:+"$place"} ${focus:+--focus} --cwd "$cwd" ${label:+--label "$label"} -- "${command[@]}")

# Attached before the gate, because a berth sign-on gives up on stays open and
# goes to work once a person answers whatever stopped it.
bilge-pump "$id" ${threshold:+--threshold "$threshold"} >&2 ||
  die "bilge-pump did not attach, so the berth $id is up with no compactor."

stuck() {
  die "the berth $id $1. It is left open to read: berth read $id, then berth close $id."
}

if [ -n "$gate" ]; then
  berth wait-text "$id" "$gate" --timeout "$start_timeout" 2>/dev/null ||
    stuck "did not show the gate '$gate' within ${start_timeout}s"
  # wait-text goes on finding the gate in recent output after it has gone,
  # so the screen is what says it cleared.
  cleared=""
  for _ in $(seq 1 10); do
    berth send-key "$id" Enter
    sleep 1
    case "$(berth read "$id")" in
      *"$gate"*) ;;
      *) cleared=1 && break ;;
    esac
  done
  [ -n "$cleared" ] || stuck "still shows the gate '$gate' after ten Enters"
else
  # A backend may read a starting agent as active before it has read the
  # screen, so the first state after gone cannot tell a gate from a turn.
  # Once the agent has shown, a gate nobody configured is the watching
  # steward's to find, as a blocked berth.
  deadline=$((SECONDS + start_timeout))
  until [ "$(berth state "$id")" != gone ]; do
    [ "$SECONDS" -lt "$deadline" ] || stuck "still has no agent after ${start_timeout}s"
    sleep 1
  done
fi

printf '%s\n' "$id"
