#!/usr/bin/env bash
# berth-herdr-app: berth's adapter for the herdr desktop app, which `berth`
# runs with the verbs already parsed. See docs/design.md, "The herdr app
# adapter".
#
# The app runs its terminals in herdr-core, and the adapter drives herdr-core
# through hc. A berth is an hc terminal, and its id is the terminal's id. A
# yard is an hc session. The relationship, the opener, the line of work and
# the label live on the terminal as hc labels.
#
# Needs: bash, coreutils, flock, grep, herdr-core, jq.
set -euo pipefail

yard=${BERTH_YARD:-${HC_SESSION:-default}}

die() {
  echo "berth (herdr-app): $1" >&2
  exit 1
}

# Every hc command starts its session's core when none is running, so the
# adapter looks for a running core itself before it asks hc anything. A
# running core holds a lock on core.lock in its session's state folder.
core_lock() { # <yard>
  echo "${XDG_STATE_HOME:-$HOME/.local/state}/herdr-core/$1/core.lock"
}

yard_running() { # <yard>
  local lock
  lock=$(core_lock "$1")
  [ -f "$lock" ] && ! flock -n "$lock" true
}

# Inside a terminal, hc reaches the terminal's own core and takes the terminal
# as its caller, so neither may override the yard.
hc_env() {
  env -u HC_TERMINAL_SOCKET -u HC_SOCKET -u HC_TERMINAL_ID HC_SESSION="$yard" "$@"
}

# Prints what hc prints. Returns 3 for a terminal hc does not have, so a caller
# can answer gone. Anything else that fails ends berth.
hc_call() {
  local out status=0 message
  yard_running "$yard" || die "the yard $yard is not up."
  out=$(hc_env hc "$1" --json "${@:2}" 2>&1) || status=$?
  [ "$status" = 0 ] && { printf '%s\n' "$out"; return; }
  [ "$status" = 3 ] && return 3
  message=$(jq -r '.error.message? // empty' <<<"$out" 2>/dev/null) || message=""
  die "hc $1 failed in yard $yard: ${message:-$out}"
}

# Runs a call on a berth that has to exist for the verb to go on.
on_berth() { # <id> <what the verb could not do> <call>...
  local id=$1 what=$2 status=0
  shift 2
  "$@" || status=$?
  case $status in
    0) ;;
    3) die "the berth $id is gone, so $what." ;;
    *) exit "$status" ;;
  esac
}

# A finished terminal is gone, as one that hc has removed is.
terminal_get() { # <id>
  local terminal
  terminal=$(hc_call get "$1") || return
  jq -e '.state == "live"' <<<"$terminal" >/dev/null || return 3
  printf '%s\n' "$terminal"
}

existing_terminal() { # <id> <what the verb could not do>
  on_berth "$1" "$2" terminal_get "$1"
}

# Every live terminal of the yard, in one call.
terminals() {
  local out
  yard_running "$yard" || die "the yard $yard is not up."
  out=$(hc_env hc connect <<<'{"jsonrpc":"2.0","id":1,"method":"terminal.list","params":{}}' 2>&1) ||
    die "hc connect failed in yard $yard: $out"
  jq -ce '.result.terminals' <<<"$out" 2>/dev/null ||
    die "hc's terminal list failed in yard $yard: $out"
}

# The given berth, or the calling terminal. A terminal id is unique only within
# its session, so the calling terminal stands for the caller only in its own
# yard.
berth_id() { # <id> [<what the verb could not do>]
  local id=$1 what=${2:-there is no berth to act on} own
  if [ -z "$id" ]; then
    [ -n "${HC_TERMINAL_ID:-}" ] || die "the caller is neither a berth nor in a herdr app terminal, so $what."
    own=${HC_SESSION:-default}
    [ "$own" = "$yard" ] || die "the caller's herdr app terminal is in the yard $own, not in $yard, so $what."
    id=$HC_TERMINAL_ID
  fi
  printf '%s\n' "$id"
}

# herdr-core takes a terminal's status only from what its program reports
# over OSC 7501.
agent_state_of='def agent_state: {working: "active", blocked: "blocked", idle: "at-rest",
  done: "at-rest", error: "at-rest"}[.status.state? // "none"];'

terminal_agent_state() { # <terminal>
  jq -r "$agent_state_of"' agent_state // "none"' <<<"$1"
}

# The command runs under the shell, so a berth whose command has exited, such
# as an agent that left, stays open at a prompt. hc gives a terminal its id
# only once it exists, so the command reads its BERTH_ID from the terminal.
# The terminal runs in herdr-core's environment, not the caller's, so the
# shell is named by its path. That environment is whatever started the core,
# which may be a herdr pane or a Claude Code session. herdr's pane variables
# would then make the berth look like that pane, and Claude Code keeps no
# transcript for a session it takes to be another's child.
# shellcheck disable=SC2016 # the berth's own shell expands it
berth_command=("$BASH" -c 'unset "${!HERDR_@}" CLAUDE_CODE_CHILD_SESSION
  export BERTH_BACKEND=herdr-app BERTH_YARD=$1 BERTH_ID=$HC_TERMINAL_ID
  shift; "$@"; exec "${SHELL:-sh}"' berth "$yard")

state_dir() {
  echo "${XDG_STATE_HOME:-$HOME/.local/state}/berth/herdr-app/$yard"
}

# A berth's command is kept where only its user can read it, because sign-on
# passes a seat's environment, secrets included, on its command line. The file
# is named for the terminal's creation as well as its id, so a command never
# reaches a terminal it was not opened in.
kept_command() { # <terminal>
  jq -r --arg dir "$(state_dir)" '"\($dir)/\(.address).\(.created_ms).command"' <<<"$1"
}

keep_command() { # <id> <command>...
  local file
  file=$(kept_command "$(existing_terminal "$1" "its command cannot be kept")")
  shift
  (umask 077 && mkdir -p "${file%/*}" && printf '%s\0' "$@" >"$file")
}

# herdr-core restarts a kept terminal with the shell alone as its program. The
# berth.restore label names the shell the adapter has already acted on.
restored='(.argv | length) == 1 and ((.labels["berth.restore"] // "") | split(" ")[0]) != (.pid | tostring)'

# Two berth calls at once would each type into the same restored shell, and
# the second line would land in the agent the first one started. So one call
# at a time restores a yard, and it reads the terminals once it holds the lock.
restore_lock() {
  mkdir -p "$(state_dir)"
  exec {restoring}>"$(state_dir)/restore.lock"
  flock "$restoring"
}

restore_unlock() {
  exec {restoring}>&-
}

# The shell is alone in the foreground for a moment before its start-up runs
# anything, such as a dev shell's hook that would swallow typed text, so it
# has to stay alone for several polls in a row, the last just before typing.
shell_settle_polls=4
shell_poll_seconds=0.25

shell_settled() { # <id>
  local _
  for _ in $(seq 1 "$shell_settle_polls"); do
    sleep "$shell_poll_seconds"
    terminal_get "$1" | jq -e '.foreground.pid == .pid' >/dev/null || return 1
  done
}

# Replaces a restored berth's shell with a command, started as a new berth's
# command is, and says on the terminal what was done with its shell. hc types nothing into a program that reports itself blocked.
type_command() { # <terminal> <outcome> <command>...
  local id pid line
  id=$(jq -r .address <<<"$1")
  pid=$(jq -r .pid <<<"$1")
  printf -v line '%q ' exec "${berth_command[@]}" "${@:3}"
  hc_call send -- "$id" "$line" >/dev/null
  hc_call label "$id" "berth.restore=$pid $2" >/dev/null
}

not_resumed() { # <terminal> <why>
  local id pid
  id=$(jq -r .address <<<"$1")
  pid=$(jq -r .pid <<<"$1")
  echo "berth (herdr-app): the berth $id is not resumed, because $2. Its shell is left bare." >&2
  hc_call label "$id" "berth.restore=$pid not resumed: $2" >/dev/null
}

# Resumes each seat that herdr-core restored, from the session id the plugin's
# mod left on its terminal. sign-on launches a seat with its prompt last, after
# --, so the resume takes the prompt's place. sign-on then gets the seat past
# its startup gate.
resume_seats() {
  local seats terminal id file command at restoring
  restore_lock
  mapfile -t seats < <(terminals | jq -c ".[] | select(.labels[\"berth.relationship\"] and .labels[\"claude.session\"] and $restored)")
  for terminal in "${seats[@]}"; do
    id=$(jq -r .address <<<"$terminal")
    shell_settled "$id" || continue
    file=$(kept_command "$terminal")
    [ -f "$file" ] || { not_resumed "$terminal" "its command was not kept"; continue; }
    mapfile -d '' -t command <"$file"
    for ((at = 0; at < ${#command[@]}; at++)); do
      [ "${command[at]}" != -- ] || break
    done
    case $((${#command[@]} - at)) in
      0) ;;
      2) command=("${command[@]:0:at}") ;;
      *) not_resumed "$terminal" "its command has more after -- than a prompt"; continue ;;
    esac
    type_command "$terminal" resumed "${command[@]}" --resume "$(jq -r '.labels["claude.session"]' <<<"$terminal")"
    if command -v sign-on >/dev/null; then
      BERTH_BACKEND=herdr-app BERTH_YARD=$yard sign-on --pass-gate "$id" </dev/null >/dev/null 2>&1 {restoring}>&- &
    else
      echo "berth (herdr-app): sign-on is not on the path, so the berth $id waits at its startup gate." >&2
    fi
  done
  restore_unlock
}

# The window shows a terminal labelled with herdr.space and herdr.tab in that
# space and tab, and makes a new one for an id it does not know.
new_place_id() { # <sp|tb>
  printf '%s%s\n' "$1" "$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
}

# Nothing can measure the window's panes while it may be closed, so a count
# stands in for the size floors that herdr's adapter measures.
workers_per_tab=4

# The tab in the opener's space where its next worker goes: the oldest of its
# workers' tabs that has room.
worker_tab() { # <opener> <space>
  local tab
  tab=$(terminals | jq -r --arg opener "$1" --arg space "$2" --argjson most "$workers_per_tab" '
    [.[] | select(.labels["berth.parent"] == $opener and .labels["berth.relationship"] == "worker"
      and .labels["herdr.space"] == $space)] | sort_by(.created_ms) | map(.labels["herdr.tab"]) as $tabs
    | first($tabs[] as $tab | select([$tabs[] | select(. == $tab)] | length < $most) | $tab) // empty')
  [ -n "$tab" ] || tab=$(new_place_id tb)
  printf '%s\n' "$tab"
}

# Names and focus belong to the window, so they wait on no window. A closed
# one leaves Herdr's own names. The window may not have seen a new terminal's
# labels yet, so a refusal is tried again for a while.
window_wait_seconds=5

window_open() {
  command -v herdr-app >/dev/null && herdr-app status >/dev/null 2>&1
}

window() { # <command> <arguments>...
  local out deadline=$((SECONDS + window_wait_seconds))
  window_open || return 0
  until out=$(herdr-app "do" "$@" 2>&1); do
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "berth (herdr-app): the window refused $1: $out" >&2
      return 0
    fi
    sleep 0.2
  done
}

# pane.rename takes a pane, which only the window's listing ties to a
# terminal.
name_pane() { # <terminal id> <label>
  local pane deadline=$((SECONDS + window_wait_seconds))
  window_open || return 0
  until pane=$(herdr-app ls 2>/dev/null | jq -er --arg terminal "$1" '
    first(.spaces[].tabs[].terminals[] | select(.terminal == $terminal) | .pane)'); do
    if [ "$SECONDS" -ge "$deadline" ]; then
      echo "berth (herdr-app): the window shows no pane for $1 to name" >&2
      return 0
    fi
    sleep 0.2
  done
  window pane.rename --pane "$pane" --name "$2"
}

# Names a berth's pane, and whatever an independent berth's place gives it:
# the space and its first tab for one opened apart, and the tab for one opened
# in a tab. The window takes a command with no id to mean what it shows, so a
# berth that the window does not show names nothing.
name_place() { # <terminal> <label>
  local space tab
  space=$(jq -r '.labels["herdr.space"] // empty' <<<"$1")
  tab=$(jq -r '.labels["herdr.tab"] // empty' <<<"$1")
  [ -n "$space" ] && [ -n "$tab" ] || return 0
  name_pane "$(jq -r .address <<<"$1")" "$2"
  jq -e '.labels["berth.relationship"] == "independent"' <<<"$1" >/dev/null || return 0
  case $(jq -r '.labels["berth.place"]' <<<"$1") in
    apart) window space.rename --id "$space" --name "$2" ;&
    tab) window tab.rename --id "$tab" --name "$2" ;;
  esac
}

open() {
  local as=$1 place=$2 focus=$3 cwd=$4 label=$5 opener=$6 id line="" opener_terminal space="" tab=""
  local workers_tab="" labels=() tender restoring
  shift 6
  resume_seats

  if [ "$as" = independent ] && [ "$place" = apart ]; then
    opener=""
    space=$(new_place_id sp)
    tab=$(new_place_id tb)
  else
    opener=$(berth_id "$opener" "there is nothing to open a berth beside")
    opener_terminal=$(existing_terminal "$opener" "there is nothing to open a berth beside")
    line=$(jq -r --arg id "$opener" '.labels["berth.line"] // $id' <<<"$opener_terminal")
    labels+=(--label "berth.line=$line")
    # A berth beside a terminal that the window does not show stays hidden too.
    space=$(jq -r '.labels["herdr.space"] // empty' <<<"$opener_terminal")
    if [ -n "$space" ]; then
      case $as/$place in
        independent/tab) tab=$(new_place_id tb) ;;
        worker/*)
          tab=$(worker_tab "$opener" "$space")
          terminals | jq -e --arg tab "$tab" 'any(.[]; .labels["herdr.tab"] == $tab)' >/dev/null ||
            workers_tab=$tab
          ;;
        *) tab=$(jq -r '.labels["herdr.tab"] // empty' <<<"$opener_terminal") ;;
      esac
    fi
  fi
  labels+=(${space:+--label "herdr.space=$space"} ${tab:+--label "herdr.tab=$tab"})

  # A tender that herdr-core restored is adopted with its command started
  # again.
  if [ "$as" = tender ] && [ -n "$label" ]; then
    restore_lock
    tender=$(terminals | jq -c --arg line "$line" --arg label "$label" '
      first(.[] | select(.labels["berth.relationship"] == "tender" and .labels["berth.line"] == $line
        and .labels["berth.label"] == $label)) // empty')
    if [ -n "$tender" ]; then
      id=$(jq -r .address <<<"$tender")
      hc_call label "$id" "berth.parent=$opener" >/dev/null
      if jq -e "$restored" <<<"$tender" >/dev/null && shell_settled "$id"; then
        type_command "$tender" "ran again" "$@"
        keep_command "$id" "$@"
      fi
      restore_unlock
      printf '%s\n' "$id"
      return
    fi
    restore_unlock
  fi

  # Closing its opener leaves an independent berth, so its opener is not its
  # parent. A kept terminal comes back as a bare shell when herdr-core
  # restarts, where a terminal not kept would come back finished.
  [ "$as" = independent ] || labels+=(--label "berth.parent=$opener")
  id=$(hc_call run --bg --keep --no-parent --no-notify --cwd "$cwd" \
    --label "berth.relationship=$as" --label "berth.place=$place" \
    ${label:+--label "berth.label=$label"} "${labels[@]}" \
    -- "${berth_command[@]}" "$@" | jq -r .address)
  keep_command "$id" "$@"
  [ -n "$line" ] || hc_call label "$id" "berth.line=$id" >/dev/null
  if [ -n "$space" ]; then
    [ -z "$label" ] || name_place "$(hc_call get "$id")" "$label"
    [ -z "$workers_tab" ] || window tab.rename --id "$workers_tab" --name workers
    [ "$focus" != focus ] || window pane.focus --terminal "$id"
  fi
  printf '%s\n' "$id"
}

name() {
  local id terminal
  id=$(berth_id "$1")
  resume_seats
  terminal=$(existing_terminal "$id" "it cannot be named")
  hc_call label "$id" "berth.label=$2" >/dev/null
  name_place "$terminal" "$2"
}

serve() {
  yard=$1
  ! yard_running "$yard" || die "the yard $yard is already being served."
  exec env -u HC_TERMINAL_SOCKET -u HC_SOCKET -u HC_TERMINAL_ID HC_SESSION="$yard" herdr-core serve
}

stop() {
  yard=$1
  yard_running "$yard" || return 0
  hc_call server stop >/dev/null
}

# Each session's core keeps a state folder of its own.
yards() {
  local dir up=()
  for dir in "${XDG_STATE_HOME:-$HOME/.local/state}"/herdr-core/*/; do
    [ -d "$dir" ] || continue
    dir=${dir%/}
    ! yard_running "${dir##*/}" || up+=("${dir##*/}")
  done
  [ ${#up[@]} = 0 ] || printf '%s\n' "${up[@]}"
}

# hc can only type text and press Enter in one go, so text sent without a key
# waits in the adapter's state until Enter submits it.
held_text() { # <id>
  echo "$(state_dir)/$1.text"
}

send_text() {
  local id held
  id=$(berth_id "$1")
  existing_terminal "$id" "it cannot take text" >/dev/null
  held=$(held_text "$id")
  mkdir -p "${held%/*}"
  printf '%s' "$2" >>"$held"
}

# berth names keys as herdr does, and hc names them in lower case.
send_key() {
  local id key held
  id=$(berth_id "$1")
  key=$(tr '[:upper:]' '[:lower:]' <<<"$2")
  [ "$key" != escape ] || key=esc
  existing_terminal "$id" "it cannot take a key" >/dev/null
  held=$(held_text "$id")
  if [ -f "$held" ]; then
    [ "$key" = enter ] ||
      die "berth $id holds text that only Enter can submit, because hc cannot type text without pressing Enter."
    on_berth "$id" "it cannot take text" hc_call send --force -- "$id" "$(cat "$held")" >/dev/null
    rm -f "$held"
  else
    on_berth "$id" "it cannot take a key" hc_call keys "$id" "$key" >/dev/null
  fi
}

# hc reads lines whole, however wide the terminal, so a line taller than the
# terminal still matches.
recent_lines=1000

wait_text() {
  local id deadline text
  id=$(berth_id "$1")
  deadline=$(($(date +%s%N) + $3 * 1000000000))
  while :; do
    text=$(on_berth "$id" "there is nothing to wait on" hc_call read "$id" --lines "$recent_lines" | jq -r .text)
    ! grep -qF -- "$2" <<<"$text" || return 0
    [ "$(date +%s%N)" -lt "$deadline" ] || return 1
    sleep 0.2
  done
}

read_screen() {
  local id
  id=$(berth_id "$1")
  on_berth "$id" "it cannot be read" hc_call read "$id" --lines 0 | jq -r .text
}

# With all, a terminal that berth did not open is listed while it runs an
# agent. Like herdr, the app keeps a terminal's session once its agent has
# left, so a berth with no agent state lists none.
list() { # <yard> <berths|all>
  yard=${1:-$yard}
  resume_seats
  terminals | jq --arg scope "$2" "$agent_state_of"'
    [.[] | agent_state as $agent
      | (.labels["berth.relationship"] // null) as $relationship
      | select($relationship != null or ($scope == "all" and $agent != null)) | {
      id: .address,
      label: (.labels["berth.label"] // null),
      relationship: $relationship,
      parent: (.labels["berth.parent"] // null),
      state: "open",
      agent_state: $agent,
      agent_session: (if $agent == null then null else .labels["claude.session"] // null end)
    }]'
}

state() {
  local id status=0
  id=$(berth_id "$1")
  terminal_get "$id" >/dev/null || status=$?
  case $status in
    0) echo open ;;
    3) echo gone ;;
    *) exit "$status" ;;
  esac
}

agent_state() {
  local id terminal status=0
  id=$(berth_id "$1")
  terminal=$(terminal_get "$id") || status=$?
  case $status in
    0) terminal_agent_state "$terminal" ;;
    3) echo none ;;
    *) exit "$status" ;;
  esac
}

# Closing a berth closes the berths it opened first.
close() {
  local id child status=0
  id=$(berth_id "$1")
  resume_seats
  terminal_get "$id" >/dev/null || status=$?
  case $status in
    0) ;;
    3) return 0 ;;
    *) exit "$status" ;;
  esac
  for child in $(terminals | jq -r --arg id "$id" '.[] | select(.labels["berth.parent"] == $id) | .address'); do
    close "$child"
  done
  hc_call kill "$id" >/dev/null || [ $? = 3 ]
  hc_call rm "$id" >/dev/null || [ $? = 3 ]
  rm -f "$(held_text "$id")" "$(state_dir)/$id".*.command
}

# The berth-pane mod shows the berth.status label beside the pane's name. An
# empty text removes the label.
status() {
  local id
  id=$(berth_id "$1")
  existing_terminal "$id" "it cannot take a status text" >/dev/null
  hc_call label "$id" "berth.status=$2" >/dev/null
}

verb=$1
shift
case "$verb" in
  serve | stop | open | name | status | list | state | close | yards) "$verb" "$@" ;;
  yard) echo "$yard" ;;
  id) berth_id "$1" ;;
  send-text) send_text "$@" ;;
  send-key) send_key "$@" ;;
  wait-text) wait_text "$@" ;;
  read) read_screen "$@" ;;
  agent-state) agent_state "$@" ;;
  *) die "berth passed an unknown verb, $verb." ;;
esac
