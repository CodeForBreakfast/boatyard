#!/usr/bin/env bash
# The herdr app adapter keeps a berth's status text in the terminal's
# berth.status hc label, which the berth-pane mod shows beside the pane's
# name. See docs/design.md, "The herdr app adapter".
#
# Run it under with-herdr-app-yard.
#
# Needs: bash, coreutils, herdr-core, jq, berth.
set -uo pipefail

work=$(mktemp -d)
failures=0

check() { # <what> <want> <got>
  if [ "$2" = "$3" ]; then
    echo "ok: $1"
  else
    echo "FAIL: $1: wanted '$2', got '$3'"
    failures=$((failures + 1))
  fi
}

status_label() { # <id>
  hc get "$1" --json | jq -r '.labels["berth.status"] // "none"'
}

seat=$(berth open --as independent --cwd "$work" -- sleep 600)

berth status "$seat" "drafting the plan"
check "status sets the berth.status label" "drafting the plan" "$(status_label "$seat")"
berth status "$seat" "reviewing"
check "a later status replaces it" reviewing "$(status_label "$seat")"
berth status "$seat" --clear
check "status --clear removes the label" none "$(status_label "$seat")"

berth close "$seat"
err=$(berth status "$seat" "too late" 2>&1 >/dev/null)
check "status on a closed berth is refused" 1 "$?"
check "the refusal says the berth is gone" true \
  "$(case $err in *"is gone"*) echo true ;; *) echo false ;; esac)"

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failed."
  exit 1
fi
echo "The herdr app adapter keeps a berth's status text in an hc label."
