#!/usr/bin/env bash
# Runs a command against a throwaway herdr app yard, a herdr-core session of
# its own, with BERTH_BACKEND and BERTH_YARD naming it. BERTH_TEST_YARD names
# the yard, which is default unless it says otherwise.
#
# HOME and every XDG folder hc uses are redirected, and every HC_* and
# HERDR_* variable unset, because an inherited HC_TERMINAL_SOCKET would
# otherwise drive the live core. The caller's own berth variables are unset
# too, because the core hands its environment to each terminal. berth serves
# the core with the assignments in BERTH_SERVED_WITH, if any, as a core served
# from another pane would be. It is stopped by the pid it was started
# with, and by nothing else.
#
# The command runs as a seat in a dev shell would, with a folder of the seat's
# own first on its PATH. A stand-in systemctl there reports the user manager's
# environment, whose PATH is the one the run started with, and
# BERTH_SESSION_PATH names it.
#
# Needs: bash, coreutils, flock, herdr-core, berth.
set -euo pipefail

[ $# -gt 0 ] || { echo "usage: with-herdr-app-yard <command>..." >&2; exit 2; }

yard=${BERTH_TEST_YARD:-default}
unset "${!HC_@}" "${!HERDR_@}" BERTH_BACKEND BERTH_YARD BERTH_ID BERTH_TEST_YARD

# A unix socket path has to fit in about a hundred bytes, so HOME stays short.
HOME=$(mktemp -d "${TMPDIR:-/tmp}/yard.XXXXXX")
export HOME XDG_RUNTIME_DIR=$HOME/run XDG_STATE_HOME=$HOME/state XDG_CONFIG_HOME=$HOME/config
export XDG_DATA_HOME=$HOME/data
mkdir -m 700 "$XDG_RUNTIME_DIR"
export SHELL=${BASH:-bash}

export BERTH_SESSION_PATH=$PATH
mkdir "$HOME/seat"
printf '#!%s\necho %q\n' "$(command -v bash)" "PATH=$PATH" >"$HOME/seat/systemctl"
chmod +x "$HOME/seat/systemctl"
PATH=$HOME/seat:$PATH

lock=$XDG_STATE_HOME/herdr-core/$yard/core.lock
up() { [ -f "$lock" ] && ! flock -n "$lock" true; }

# shellcheck disable=SC2086 # each assignment is a word of its own
env ${BERTH_SERVED_WITH:-} BERTH_BACKEND=herdr-app berth serve "$yard" >"$HOME/core.log" 2>&1 &
core=$!
stop_core() {
  kill "$core" 2>/dev/null || true
  wait "$core" 2>/dev/null || true
}
trap stop_core EXIT

until up; do
  if ! kill -0 "$core" 2>/dev/null || [ "$SECONDS" -gt 30 ]; then
    echo "with-herdr-app-yard: herdr-core did not come up." >&2
    cat "$HOME/core.log" >&2
    exit 1
  fi
  sleep 0.1
done

export BERTH_BACKEND=herdr-app BERTH_YARD=$yard
"$@"
