#!/usr/bin/env bash
# The port contract: what every berth adapter must do. See docs/design.md,
# "The port: berth" and "Testing".
#
# Run it with berth on the path, and BERTH_BACKEND and BERTH_YARD naming a
# yard that is up and holds no berths. It reads nothing of any backend, so a
# second adapter runs it unchanged.
#
# Needs: bash, coreutils, jq, berth.
set -uo pipefail

: "${BERTH_BACKEND:?}" "${BERTH_YARD:?}"
unset BERTH_ID

work=$(mktemp -d)
failures=0

check() { # <what> <want> <got>
  if [ "$2" = "$3" ]; then
    echo "ok: $1"
  else
    echo "FAIL: $1: wanted '$2', got '$3'"
    failures=$((failures + 1))
  fi
}

refused() { # <what> <command>...
  local what=$1 err
  shift
  if err=$("$@" 2>&1 >/dev/null); then
    echo "FAIL: $what: it succeeded"
    failures=$((failures + 1))
  else
    check "$what, with the reason on stderr" true "$([ -n "$err" ] && echo true || echo false)"
  fi
}

field() { # <id> <field>
  berth list | jq -r --arg id "$1" --arg field "$2" \
    '.[] | select(.id == $id) | .[$field] // "null"'
}

listed() { # <id>
  berth list | jq -r --arg id "$1" 'any(.[]; .id == $id)'
}

# Opens a berth whose command records the environment it was given.
open_recording() { # <relationship> <label> <record>
  # shellcheck disable=SC2016 # the berth's own shell expands it
  berth open --as "$1" --cwd "$work" --label "$2" -- \
    bash -c 'env >"$1.part" && mv "$1.part" "$1"' recorder "$3"
}

recorded() { # <record> <variable>
  local _
  for _ in $(seq 1 100); do
    [ -f "$1" ] && break
    sleep 0.1
  done
  sed -n "s/^$2=//p" "$1" 2>/dev/null
}

echo "# open in each relationship"

independent=$(open_recording independent "a line of work" "$work/independent")
check "an independent berth is listed as independent" independent "$(field "$independent" relationship)"
check "an independent berth has no parent" null "$(field "$independent" parent)"
check "an independent berth takes its label" "a line of work" "$(field "$independent" label)"
check "the command learns its own BERTH_ID" "$independent" "$(recorded "$work/independent" BERTH_ID)"
check "the command learns BERTH_BACKEND" "$BERTH_BACKEND" "$(recorded "$work/independent" BERTH_BACKEND)"
check "the command learns BERTH_YARD" "$BERTH_YARD" "$(recorded "$work/independent" BERTH_YARD)"

# The rest are opened from inside the independent berth, as its own
# command would open them.
worker=$(BERTH_ID=$independent open_recording worker "a worker" "$work/worker")
check "a worker is listed as a worker" worker "$(field "$worker" relationship)"
check "a worker's parent is its opener" "$independent" "$(field "$worker" parent)"
check "a worker's command learns its own BERTH_ID" "$worker" "$(recorded "$work/worker" BERTH_ID)"
check "a worker inherits BERTH_YARD" "$BERTH_YARD" "$(recorded "$work/worker" BERTH_YARD)"

second_worker=$(BERTH_ID=$independent berth open --as worker --cwd "$work" -- true)
check "a second worker has the same parent" "$independent" "$(field "$second_worker" parent)"
check "a berth opened without a label has none" null "$(field "$second_worker" label)"

tender=$(BERTH_ID=$independent open_recording tender "a view" "$work/tender")
check "a tender is listed as a tender" tender "$(field "$tender" relationship)"
check "a tender's parent is its opener" "$independent" "$(field "$tender" parent)"
check "a tender's command learns its own BERTH_ID" "$tender" "$(recorded "$work/tender" BERTH_ID)"

check "every id is distinct" 4 "$(printf '%s\n' "$independent" "$worker" "$second_worker" "$tender" | sort -u | wc -l)"
check "the list is JSON with the port's fields" true "$(berth list | jq 'all(.[]; keys == ["agent_session", "agent_state", "id", "label", "parent", "relationship", "state"])')"

echo "# yard"

check "yard prints the yard the caller is in" "$BERTH_YARD" "$(berth yard)"
check "yard prints the yard of a caller that is not a berth" "$BERTH_YARD" \
  "$(env -u BERTH_ID -u BERTH_YARD berth yard)"
refused "yard takes no argument" berth yard "$BERTH_YARD"

echo "# id"

check "id prints the calling berth" "$worker" "$(BERTH_ID=$worker berth id)"
refused "id takes no argument" env BERTH_ID="$worker" berth id "$worker"

echo "# name"

berth name "$worker" "renamed"
check "name relabels a berth" renamed "$(field "$worker" label)"
BERTH_ID=$worker berth name "named by itself"
check "name with no id relabels the calling berth" "named by itself" "$(field "$worker" label)"
berth name "$independent" "renamed line"
check "name relabels an independent berth" "renamed line" "$(field "$independent" label)"

echo "# send-text, send-key, wait-text and read"

# Every pattern this section waits for is built by the berth's command at
# run time, so the command line the berth echoes never matches it.
# shellcheck disable=SC2016 # the berth's own shell expands it
typist=$(berth open --as independent --cwd "$work" -- \
  bash -c 'echo "${1^^}"; while read -r line; do echo "heard ${line^^}"; done' typist ready)
berth wait-text "$typist" READY --timeout 10
check "wait-text sees what a berth prints" 0 "$?"

berth send-text "$typist" "hello"
started=$(date +%s%N)
berth wait-text "$typist" "heard HELLO" --timeout 1 2>/dev/null
check "text sent without a key is not submitted, so wait-text fails at its timeout" 1 "$?"
check "wait-text waits out its timeout before it fails" true \
  "$([ $(($(date +%s%N) - started)) -ge 1000000000 ] && echo true || echo false)"

berth send-key "$typist" Enter
BERTH_ID=$typist berth wait-text "heard HELLO" --timeout 10
check "send-key submits the text, and wait-text with no id watches the calling berth" 0 "$?"

check "read prints the visible screen" true \
  "$(berth read "$typist" | grep -q 'heard HELLO' && echo true || echo false)"
check "read prints plain text" false \
  "$(berth read "$typist" | grep -q $'\e' && echo true || echo false)"
check "read with no id reads the calling berth" true \
  "$(BERTH_ID=$typist berth read | grep -q 'heard HELLO' && echo true || echo false)"

BERTH_ID=$typist berth send-text "again"
BERTH_ID=$typist berth send-key Enter
berth wait-text "$typist" "heard AGAIN" --timeout 10
check "send-text and send-key with no id reach the calling berth" 0 "$?"

# A line this long wraps to more rows than a pane has, so it is never on
# screen whole.
tall=$(berth open --as independent --cwd "$work" -- bash -c 'printf "%020000d\n" 0; sleep 600')
berth wait-text "$tall" "$(printf '%020000d' 0)" --timeout 10
check "wait-text sees text taller than its berth" 0 "$?"

refused "wait-text needs a timeout" berth wait-text "$typist" READY
refused "wait-text needs a timeout in whole seconds" berth wait-text "$typist" READY --timeout soon

berth close "$typist"
berth close "$tall"

echo "# state"

# A backend knows Claude Code by its process name and reads its state from
# the screen, so a copy of bash named claude stands in for it and draws
# Claude's screens on cue.
cp "$(command -v bash)" "$work/claude"
cat >"$work/stand-in" <<'EOF'
prompt_box() { printf '\n────────\n❯ \n────────\n'; }
screen=rest
while :; do
  printf '\e[H\e[2J\e[3J'
  case $screen in
    rest) printf '\e]0;✳ Claude\a'; prompt_box ;;
    turn) printf '\e]0;⠂ Claude\a✻ Thinking… (esc to interrupt)\n' ;;
    parked) printf '\e]0;⠂ Claude\a✻ Waiting for 2 background agents to finish\n'; prompt_box ;;
    permission) printf '\e]0;✳ Claude\aDo you want to proceed?\n❯ 1. Yes\n  2. No\n\nEsc to cancel\n' ;;
    leave) exit ;;
  esac
  read -r screen
done
EOF

# A backend may take a few seconds to read a screen, so an agent state is
# awaited rather than read once. The list holds null where agent-state
# prints none.
settles() { # <what> <id> <want>
  local got listed _
  for _ in $(seq 1 200); do
    got=$(berth agent-state "$2")
    [ "$got" = "$3" ] && break
    sleep 0.1
  done
  listed=$3
  [ "$listed" != none ] || listed=null
  check "$1 reads $3" "$3" "$got"
  check "$1 is listed as $3" "$listed" "$(field "$2" agent_state)"
  check "$1 is open" open "$(berth state "$2")"
  check "$1 is listed as open" open "$(field "$2" state)"
}

shows() { # <id> <screen>
  berth send-text "$1" "$2"
  berth send-key "$1" Enter
}

agent=$(berth open --as independent --cwd "$work" -- "$work/claude" --norc --noprofile "$work/stand-in")
settles "an agent at its prompt" "$agent" at-rest
shows "$agent" turn
settles "an agent with a turn in flight" "$agent" active
shows "$agent" parked
settles "an agent parked while background work runs" "$agent" at-rest
shows "$agent" permission
settles "an agent at a permission prompt" "$agent" blocked
check "agent-state with no id reads the calling berth" blocked "$(BERTH_ID=$agent berth agent-state)"
check "state with no id reads the calling berth" open "$(BERTH_ID=$agent berth state)"
shows "$agent" leave
settles "a berth whose agent has left for its shell" "$agent" none
check "a berth whose agent has left holds no agent session" null "$(field "$agent" agent_session)"
berth close "$agent"

shell=$(berth open --as independent --cwd "$work" -- sleep 600)
settles "a berth running something other than an agent" "$shell" none
check "a berth running something other than an agent holds no agent session" null "$(field "$shell" agent_session)"
berth close "$shell"

echo "# close"

berth close "$second_worker"
check "a closed berth is not listed" false "$(listed "$second_worker")"
check "a closed berth reports gone" gone "$(berth state "$second_worker")"
check "a closed berth holds no agent" none "$(berth agent-state "$second_worker")"
check "closing a worker leaves its opener" true "$(listed "$independent")"
check "closing a worker leaves its sibling" true "$(listed "$worker")"
berth close "$second_worker"
check "closing a closed berth succeeds" 0 "$?"

nested=$(BERTH_ID=$worker berth open --as tender --cwd "$work" -- true)
BERTH_ID=$worker berth close
check "close with no id closes the calling berth" false "$(listed "$worker")"
check "closing a berth closes what it opened" false "$(listed "$nested")"

echo "# the cascade"

another=$(BERTH_ID=$independent berth open --as worker --cwd "$work" -- true)
berth close "$independent"
for id in "$independent" "$another" "$tender"; do
  check "closing an independent berth closes $id" false "$(listed "$id")"
done
check "the yard holds no berths" 0 "$(berth list | jq length)"

echo "# an independent berth beside its caller"

caller=$(berth open --as independent --cwd "$work" -- true)
beside=$(BERTH_ID=$caller berth open --as independent --beside --cwd "$work" -- true)
check "it is listed as independent" independent "$(field "$beside" relationship)"
check "it has no parent" null "$(field "$beside" parent)"
berth close "$caller"
check "closing its caller leaves it" true "$(listed "$beside")"

caller=$(berth open --as independent --cwd "$work" -- true)
other=$(BERTH_ID=$caller berth open --as independent --beside --cwd "$work" -- true)
berth close "$other"
check "closing it leaves its caller" true "$(listed "$caller")"
berth close "$caller"
berth close "$beside"

echo "# an independent berth in a tab of its caller's"

caller=$(berth open --as independent --cwd "$work" -- true)
tabbed=$(BERTH_ID=$caller berth open --as independent --tab --cwd "$work" -- true)
check "it is listed as independent" independent "$(field "$tabbed" relationship)"
check "it has no parent" null "$(field "$tabbed" parent)"
berth close "$tabbed"
check "closing it leaves its caller" true "$(listed "$caller")"
tabbed=$(BERTH_ID=$caller berth open --as independent --tab --cwd "$work" -- true)
berth close "$caller"
check "closing its caller leaves it" true "$(listed "$tabbed")"
berth close "$tabbed"

echo "# a labelled tender opens once in a line of work"

line=$(berth open --as independent --cwd "$work" -- true)
view=$(BERTH_ID=$line berth open --as tender --cwd "$work" --label "a view" -- true)
again=$(BERTH_ID=$line open_recording tender "a view" "$work/again")
check "opening it again gives the open tender" "$view" "$again"
check "opening it again runs no command" "" "$(recorded "$work/again" BERTH_ID)"
check "opening it again leaves one tender" 1 "$(berth list | jq '[.[] | select(.relationship == "tender")] | length')"
other=$(BERTH_ID=$line berth open --as tender --cwd "$work" --label "another view" -- true)
check "a tender with another label opens anew" true "$([ "$other" != "$view" ] && echo true || echo false)"

successor=$(BERTH_ID=$line berth open --as independent --beside --cwd "$work" -- true)
check "a berth beside the opener gives the open tender" "$view" \
  "$(BERTH_ID=$successor berth open --as tender --cwd "$work" --label "a view" -- true)"
check "it is still a tender" tender "$(field "$view" relationship)"
check "its parent becomes the berth that opened it again" "$successor" "$(field "$view" parent)"

apart=$(berth open --as independent --cwd "$work" -- true)
elsewhere=$(BERTH_ID=$apart berth open --as tender --cwd "$work" --label "a view" -- true)
check "a line of work apart opens a tender of its own" true "$([ "$elsewhere" != "$view" ] && echo true || echo false)"

berth close "$successor"
check "closing the berth that opened it again closes it" false "$(listed "$view")"
berth close "$line"
berth close "$apart"

echo "# serve and stop"

served="$BERTH_YARD-served"
berth serve "$served" >"$work/serve.log" 2>&1 &
serving=$!
trap 'kill "$serving" 2>/dev/null' EXIT
for _ in $(seq 1 100); do
  berth list "$served" >/dev/null 2>&1 && break
  sleep 0.1
done
check "serve brings a yard up" 0 "$(berth list "$served" | jq length)"
check "serve stays in the foreground" true "$(kill -0 "$serving" 2>/dev/null && echo true || echo false)"
refused "a yard that is being served cannot be served again" berth serve "$served"

berth stop "$served"
check "stop succeeds" 0 "$?"
wait "$serving"
check "serve exits 0 once its yard stops" 0 "$?"
trap - EXIT
refused "a stopped yard cannot list its berths" berth list "$served"
berth stop "$served"
check "stopping a stopped yard succeeds" 0 "$?"

echo "# errors"

refused "a berth needs a backend named" env -u BERTH_BACKEND berth list
refused "a backend with no adapter is refused" env BERTH_BACKEND=no-such-backend berth list
refused "a worker needs an opener" berth open --as worker --cwd "$work" -- true
refused "a tender needs an opener" berth open --as tender --cwd "$work" -- true
refused "a worker's opener has to exist" env BERTH_ID="$independent" berth open --as worker --cwd "$work" -- true
refused "a berth beside its caller needs a caller" berth open --as independent --beside --cwd "$work" -- true
refused "only an independent berth opens beside its caller" \
  env BERTH_ID="$caller" berth open --as tender --beside --cwd "$work" -- true
refused "a berth in a tab of its caller's needs a caller" berth open --as independent --tab --cwd "$work" -- true
refused "only an independent berth opens in a tab of its caller's" \
  env BERTH_ID="$caller" berth open --as worker --tab --cwd "$work" -- true
refused "a berth opens either beside its caller or in a tab, not both" \
  env BERTH_ID="$caller" berth open --as independent --beside --tab --cwd "$work" -- true
refused "a gone berth cannot be named" berth name "$independent" "too late"
refused "a gone berth cannot take text" berth send-text "$independent" "too late"
refused "a gone berth cannot take a key" berth send-key "$independent" Enter
refused "a gone berth cannot be waited on" berth wait-text "$independent" "too late" --timeout 1
refused "a gone berth cannot be read" berth read "$independent"
refused "serve needs a yard" berth serve
refused "open needs a relationship it knows" berth open --as stranger --cwd "$work" -- true
refused "open needs a command" berth open --as independent --cwd "$work"
state=$(berth state "$independent")
check "state on a gone berth answers and exits 0" "gone 0" "$state $?"
state=$(berth agent-state "$independent")
check "agent-state on a gone berth answers and exits 0" "none 0" "$state $?"

err=$(env BERTH_YARD=no-such-yard berth list 2>&1 >/dev/null) && status=0 || status=$?
check "an unreachable yard fails" 1 "$([ "$status" != 0 ] && echo 1 || echo 0)"
check "the failure names the adapter" true "$(case "$err" in *"$BERTH_BACKEND"*) echo true ;; *) echo false ;; esac)"

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failed."
  exit 1
fi
echo "The contract holds for $BERTH_BACKEND."
