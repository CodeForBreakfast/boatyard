#!/usr/bin/env bash
# sign-on's tests: it opens a berth, starts the configured command in it opted
# in to the plugin's compaction mod, and gets past the startup gate. See
# docs/design.md, "sign-on".
#
# Run it with sign-on and berth on the path, and BERTH_BACKEND and BERTH_YARD
# naming a yard that is up.
#
# Needs: bash, coreutils, git, jq.
set -uo pipefail

: "${BERTH_BACKEND:?}" "${BERTH_YARD:?}"
unset BERTH_ID

work=$(mktemp -d)
failures=0

check() { # <what> <want> <got>
  if [ "$2" = "$3" ]; then
    echo "ok: $1"
  else
    echo "FAIL: $1: wanted '$2', got '$3'"
    failures=$((failures + 1))
  fi
}

contains() { # <text> <part>
  case "$1" in *"$2"*) echo true ;; *) echo false ;; esac
}

# Waits up to ten seconds for a command to succeed.
eventually() { # <command>...
  local _
  for _ in $(seq 1 100); do
    "$@" && return 0
    sleep 0.1
  done
  return 1
}

gate="I am using this for local development"
trust_prompt="Is this a project you created or one you trust?"

# A backend knows Claude Code by its process name, so a copy of bash named
# claude stands in for it. It shows the gate until it has had the given
# number of Enters, then draws the given screen, as the berth contract's
# stand-in does.
cp "$(command -v bash)" "$work/claude"
cat >"$work/stand-in" <<EOF
prompt_box() { printf '\n────────\n❯ \n────────\n'; }
screen=\$1 enters=\$2
# Like Claude Code, it asks first whether to trust a folder its config does
# not trust, nor any folder above it, with the answer that quits focused.
trusted=\$PWD
until jq -e --arg d "\$trusted" '.projects[\$d].hasTrustDialogAccepted == true' \\
  "\${CLAUDE_CONFIG_DIR:-\$HOME}/.claude.json" >/dev/null 2>&1; do
  if [ "\$trusted" = / ]; then
    printf '$trust_prompt\n❯ No, exit\n  Yes, I trust this folder\n'
    read -r _
    exit 1
  fi
  trusted=\$(dirname "\$trusted")
done
# A screen that buries the gate under something else, so that wait-text
# still finds the gate in recent output while the screen shows another.
if [ "\$screen" = mystery ]; then
  printf 'Loading development channels\n❯ 1. $gate\n  2. Exit\n'
  for _ in \$(seq 1 200); do echo; done
fi
if [ "\$enters" -gt 0 ]; then
  printf 'Loading development channels\n❯ 1. $gate\n  2. Exit\n'
  while [ "\$enters" -gt 0 ]; do
    read -r _
    echo x >>"\$KEYS"
    enters=\$((enters - 1))
  done
  # Scrolled away rather than cleared, so the gate stays in the recent
  # output that wait-text searches.
  for _ in \$(seq 1 200); do echo; done
fi
while :; do
  printf '\e[H\e[2J'
  case \$screen in
    rest) printf '\e]0;✳ Claude\a'; prompt_box ;;
    turn) printf '\e]0;⠂ Claude\a✻ Thinking… (esc to interrupt)\n' ;;
    trust) printf '$trust_prompt\n❯ No, exit\n  Yes, I trust this folder\n' ;;
    mystery) printf 'Select a theme\n❯ 1. Dark\n  2. Light\n' ;;
  esac
  read -r screen
  echo x >>"\$KEYS"
done
EOF

# The command sign-on is configured with. It records what it was given, then
# becomes the stand-in.
seat() { # <name> <screen> <enters the gate takes>
  mkdir -p "$work/$1"
  cat >"$work/$1/seat" <<EOF
#!$BASH
printf '%s\n' "\$@" >"$work/$1/args"
env >"$work/$1/env"
pwd >"$work/$1/pwd"
export KEYS="$work/$1/keys"
exec "$work/claude" --norc --noprofile "$work/stand-in" $2 $3
EOF
  chmod +x "$work/$1/seat"
  printf '%s\n' "$work/$1/seat"
}

trusts() { # <dir>
  jq -e --arg d "$(cd "$1" && pwd -P)" '.projects[$d].hasTrustDialogAccepted == true' \
    "${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json" >/dev/null 2>&1 && echo true || echo false
}

recorded() { # <name> <variable>
  eventually test -f "$work/$1/env"
  sed -n "s/^$2=//p" "$work/$1/env"
}

export SIGN_ON_START_TIMEOUT=30
# The host running these tests may be short of memory, so only the tests of
# the memory floor set one.
export SIGN_ON_MIN_MEMORY=0
mkdir -p "$work/project" "$work/extra"
prompt="/boatyard:worker #project/effort-bead, then read this project's \"brief\" \$HOME \`id\` &"

echo "# a configured gate"

# Every process sign-on starts inherits the mark, and the seat does not,
# because the yard's server starts it.
mark="SIGN_ON_TEST_MARK=$work"
marked() { grep -lsxzF "$mark" /proc/[0-9]*/environ; }

id=$(env "$mark" SIGN_ON_CLAUDE="$(seat gated rest 2)" SIGN_ON_GATE="$gate" SIGN_ON_MCP_TIMEOUT=120000 \
  sign-on --as independent --cwd "$work/project" --label "a seat" --model a-model \
  --effort high --add-dir "$work/extra" --env SEAT_ROLE=tester \
  --settings "$work/settings.json" --threshold 70 "$prompt" 2>"$work/gated.err")
check "sign-on succeeds" 0 "$?"
check "it prints only the berth's id" 1 "$(printf '%s\n' "$id" | wc -l)"
check "it opens the berth in the relationship given" independent \
  "$(berth list | jq -r --arg id "$id" '.[] | select(.id == $id) | .relationship')"
check "it labels the berth" "a seat" \
  "$(berth list | jq -r --arg id "$id" '.[] | select(.id == $id) | .label')"
check "the command gets the launch's flags, then the prompt whole" \
  "--model a-model --effort high --add-dir $work/extra --settings $work/settings.json -- $prompt" \
  "$(tr '\n' ' ' <"$work/gated/args" | sed 's/ $//')"
check "the command starts in the working directory given" "$work/project" "$(cat "$work/gated/pwd")"
check "the command learns its BERTH_ID" "$id" "$(recorded gated BERTH_ID)"
check "the command learns its BERTH_YARD" "$BERTH_YARD" "$(recorded gated BERTH_YARD)"
check "the command gets the launch's environment" tester "$(recorded gated SEAT_ROLE)"
check "the command gets the MCP start-up timeout" 120000 "$(recorded gated MCP_TIMEOUT)"
check "the gate took two Enters and is gone from the screen" false \
  "$(contains "$(berth read "$id")" "$gate")"
berth wait-text "$id" "$gate" --timeout 1 2>/dev/null
check "wait-text still finds the cleared gate, so it cannot say when a gate goes" 0 "$?"
check "the command takes the launch's threshold for the compaction mod" 70 \
  "$(recorded gated BOATYARD_COMPACT_THRESHOLD)"
check "the seat does not carry the mark" false \
  "$(grep -qx "$mark" "$work/gated/env" && echo true || echo false)"
check "sign-on leaves no process of its own running" "" "$(marked)"
opener=$id

echo "# no gate configured"

id=$(SIGN_ON_CLAUDE=$(seat resting rest 0) sign-on --as independent --cwd "$work/project" "$prompt")
check "an agent at its prompt has shown" 0 "$?"
check "with no flags, the command gets only the prompt" "-- $prompt" \
  "$(tr '\n' ' ' <"$work/resting/args" | sed 's/ $//')"
# The yard's own environment reaches every berth, so "none" is whatever that
# holds.
check "with no timeout configured, sign-on sets none" "${MCP_TIMEOUT:-}" "$(recorded resting MCP_TIMEOUT)"
check "with no threshold, the command is opted in to the mod at the plugin setting" true \
  "$(grep -qx "BOATYARD_COMPACT_THRESHOLD=" "$work/resting/env" && echo true || echo false)"

id=$(SIGN_ON_CLAUDE=$(seat busy turn 0) sign-on --as independent --cwd "$work/project" "$prompt")
check "an agent already in its first turn has shown" 0 "$?"

id=$(BERTH_ID=$opener SIGN_ON_CLAUDE=$(seat worker rest 0) \
  sign-on --as worker --cwd "$work/project" --label bead "$prompt")
check "a worker is opened beside its opener" "$opener" \
  "$(berth list | jq -r --arg id "$id" '.[] | select(.id == $id) | .parent')"

echo "# no prompt"

id=$(SIGN_ON_CLAUDE=$(seat idle rest 2) SIGN_ON_GATE=$gate \
  sign-on --as independent --cwd "$work/project" --model a-model 2>"$work/idle.err")
check "sign-on succeeds with no prompt" 0 "$?"
check "the command gets the launch's flags and no first message" "--model a-model" \
  "$(tr '\n' ' ' <"$work/idle/args" | sed 's/ $//')"
check "the gate is gone from the screen" false "$(contains "$(berth read "$id")" "$gate")"

echo "# each seat claims as an actor of its own"

# The yard's own environment reaches every berth, so a host that sets an actor
# there would otherwise make every seat the same one.
export BEADS_ACTOR=host-actor
BERTH_ID=$opener SIGN_ON_CLAUDE=$(seat actor_a rest 0) sign-on --as worker --cwd "$work/project" "$prompt" >/dev/null
BERTH_ID=$opener SIGN_ON_CLAUDE=$(seat actor_b rest 0) sign-on --as worker --cwd "$work/project" "$prompt" >/dev/null
actor_a=$(recorded actor_a BEADS_ACTOR)
actor_b=$(recorded actor_b BEADS_ACTOR)
check "a seat runs with an actor of its own, not the host's" true \
  "$([ -n "$actor_a" ] && [ "$actor_a" != host-actor ] && echo true || echo false)"
check "the actor says what kind of seat it is" worker "${actor_a%%-*}"
check "two seats get different actors" true "$([ "$actor_a" != "$actor_b" ] && echo true || echo false)"
unset BEADS_ACTOR
BERTH_ID=$opener SIGN_ON_CLAUDE=$(seat actor_c rest 0) sign-on --as tender --cwd "$work/project" "$prompt" >/dev/null
check "a seat launched with no actor in its environment gets one" tender "$(recorded actor_c BEADS_ACTOR | cut -d- -f1)"
BERTH_ID=$opener SIGN_ON_CLAUDE=$(seat actor_d rest 0) sign-on --as worker --cwd "$work/project" --env BEADS_ACTOR=named "$prompt" >/dev/null
check "an actor the launch names wins" named "$(recorded actor_d BEADS_ACTOR)"

echo "# a caller can land on the seat"

# The herdr layout suite proves that berth honours --focus, so here a berth
# that records its arguments shows only that sign-on asks for it.
mkdir -p "$work/recorder"
cat >"$work/recorder/berth" <<EOF
#!$BASH
[ "\$1" != open ] || printf '%s\n' "\$*" >>"$work/opens"
exec $(command -v berth) "\$@"
EOF
chmod +x "$work/recorder/berth"
opened_with_focus() { # <relationship>
  grep -q -- "^open --as $1 --focus " "$work/opens" 2>/dev/null && echo true || echo false
}
PATH=$work/recorder:$PATH SIGN_ON_CLAUDE=$(seat unfocused rest 0) \
  sign-on --as independent --cwd "$work/project" "$prompt" >/dev/null
check "a seat opens without focus by default" false "$(opened_with_focus independent)"
PATH=$work/recorder:$PATH SIGN_ON_CLAUDE=$(seat focused rest 0) \
  sign-on --as independent --focus --cwd "$work/project" "$prompt" >/dev/null
check "--focus opens the seat with focus" true "$(opened_with_focus independent)"

echo "# a seat a person works in starts a steward beside itself"

PATH=$work/recorder:$PATH BERTH_ID=$opener SIGN_ON_CLAUDE=$(seat beside rest 0) \
  sign-on --as independent --beside --cwd "$work/project" "$prompt" >/dev/null
check "--beside opens the seat beside its caller" true \
  "$(grep -q -- "^open --as independent --beside " "$work/opens" && echo true || echo false)"
PATH=$work/recorder:$PATH BERTH_ID=$opener SIGN_ON_CLAUDE=$(seat tabbed rest 0) \
  sign-on --as independent --tab --cwd "$work/project" "$prompt" >/dev/null
check "--tab opens the seat in a tab of its caller's" true \
  "$(grep -q -- "^open --as independent --tab " "$work/opens" && echo true || echo false)"
check "a seat opens apart from its caller by default" true \
  "$(grep -q -- "^open --as independent --cwd " "$work/opens" && echo true || echo false)"

echo "# a seat is born in the main checkout"

export GIT_AUTHOR_NAME=fixture GIT_AUTHOR_EMAIL=fixture@example.invalid
export GIT_COMMITTER_NAME=fixture GIT_COMMITTER_EMAIL=fixture@example.invalid
git init --quiet "$work/repo"
git -C "$work/repo" commit --quiet --allow-empty -m base
git -C "$work/repo" worktree add --quiet "$work/linked" 2>/dev/null
mkdir -p "$work/repo/sub"

SIGN_ON_CLAUDE=$(seat linked rest 0) \
  sign-on --as independent --cwd "$work/linked" "$prompt" >/dev/null 2>"$work/linked.err"
check "a linked worktree gives way to its main checkout" "$(cd "$work/repo" && pwd -P)" \
  "$(cat "$work/linked/pwd")"
check "and sign-on says so" true "$(contains "$(cat "$work/linked.err")" "$work/linked")"

SIGN_ON_CLAUDE=$(seat sub rest 0) \
  sign-on --as independent --cwd "$work/repo/sub" "$prompt" >/dev/null 2>"$work/sub.err"
check "a directory inside the main checkout stays as given" "$work/repo/sub" "$(cat "$work/sub/pwd")"
check "and sign-on says nothing of it" "" "$(cat "$work/sub.err")"
check "a folder in a repository is trusted at the repository's top" true "$(trusts "$work/repo")"

echo "# a folder Claude Code has never trusted"

config=${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json
jq '.theme = "a-theme"' "$config" >"$work/config" && cp "$work/config" "$config"
mkdir -p "$work/untrusted"
id=$(SIGN_ON_CLAUDE=$(seat untrusted rest 2) SIGN_ON_GATE=$gate \
  sign-on --as independent --cwd "$work/untrusted" "$prompt" 2>"$work/untrusted.err")
check "a seat launched into an untrusted folder gets past its gate" 0 "$?"
check "and sign-on says on stderr that it trusts the folder" true \
  "$(contains "$(cat "$work/untrusted.err")" "trusts $work/untrusted")"
check "and reaches its prompt" true "$(contains "$(berth read "$id")" "────────")"
check "Claude Code's config trusts the folder" true "$(trusts "$work/untrusted")"
check "and keeps the rest of the config" a-theme "$(jq -r .theme "$config")"
check "sign-on leaves Claude Code's config lock free" false "$(test -e "$config.lock" && echo true || echo false)"

inode=$(stat -c %i "$config")
SIGN_ON_CLAUDE=$(seat trusted rest 0) sign-on --as independent --cwd "$work/untrusted" "$prompt" \
  >/dev/null 2>"$work/trusted.err"
check "a folder already trusted leaves the config as it was" "$inode" "$(stat -c %i "$config")"
check "and sign-on says nothing of it" "" "$(cat "$work/trusted.err")"

mkdir -p "$work/held" "$config.lock"
SIGN_ON_CLAUDE=$(seat held rest 0) sign-on --as independent --cwd "$work/held" "$prompt" >/dev/null &
waiter=$!
sleep 1
check "while Claude Code holds its config lock, sign-on waits" false "$(trusts "$work/held")"
rmdir "$config.lock"
wait "$waiter"
check "and records the trust once the lock is free" true "$(trusts "$work/held")"

mkdir -p "$work/abandoned" "$config.lock"
touch -d '1 minute ago' "$config.lock"
SIGN_ON_CLAUDE=$(seat abandoned rest 0) sign-on --as independent --cwd "$work/abandoned" "$prompt" >/dev/null
check "a lock left behind by a Claude Code that died is taken over" true "$(trusts "$work/abandoned")"
check "and freed" false "$(test -e "$config.lock" && echo true || echo false)"

echo "# a screen that is not the gate"

keys() { # <name>
  if [ -f "$work/$1/keys" ]; then wc -l <"$work/$1/keys" | tr -d ' '; else echo 0; fi
}

err=$(SIGN_ON_CLAUDE="$(seat dialog trust 1)" SIGN_ON_GATE=$gate \
  sign-on --as independent --cwd "$work/project" "$prompt" 2>&1 >/dev/null)
check "a trust dialog after the first Enter fails" 1 "$?"
check "and the first Enter was the only key sent" 1 "$(keys dialog)"
check "and sign-on names the trust dialog" true "$(contains "$err" "trust dialog")"
check "and the seat's folder" true "$(contains "$err" "$work/project")"
check "and the berth" true "$(contains "$err" "berth ")"
check "and leaves the berth open" true \
  "$(berth list | jq -r --arg id "$(sed -n 's/.*the berth \([^ ]*\) .*/\1/p' <<<"$err")" 'any(.[]; .id == $id)')"

err=$(SIGN_ON_CLAUDE="$(seat mystery mystery 0)" SIGN_ON_GATE=$gate \
  sign-on --as independent --cwd "$work/project" "$prompt" 2>&1 >/dev/null)
check "a screen it does not recognise fails" 1 "$?"
check "and no key was sent to it" 0 "$(keys mystery)"
check "and sign-on says it does not recognise the screen" true "$(contains "$err" "does not recognise")"

echo "# a caller that is not a berth"

# A pane a person opened by hand has no BERTH_ID or BERTH_YARD, so the yard
# is whatever berth resolves for it.
id=$(env -u BERTH_ID -u BERTH_YARD SIGN_ON_CLAUDE="$(seat plain rest 0)" \
  sign-on --as independent --cwd "$work/project" "$prompt" 2>"$work/plain.err")
check "sign-on succeeds with no BERTH_YARD" 0 "$?"
check "the berth opens in the yard berth resolves" true \
  "$(berth list | jq -r --arg id "$id" 'any(.[]; .id == $id)')"
check "the command learns that BERTH_YARD" "$BERTH_YARD" "$(recorded plain BERTH_YARD)"

echo "# failures"

fails() { # <what> <word the reason has> <sign-on's environment and arguments>...
  local what=$1 word=$2 err status
  shift 2
  err=$(env "$@" 2>&1 >/dev/null) && status=0 || status=$?
  check "$what fails" true "$([ "$status" != 0 ] && echo true || echo false)"
  check "$what says why" true "$(contains "$err" "$word")"
}

fails "a command that never becomes an agent" "no agent" \
  SIGN_ON_CLAUDE=true SIGN_ON_START_TIMEOUT=3 sign-on --as independent --cwd "$work/project" "$prompt"
fails "a gate that never appears" "$gate" \
  SIGN_ON_CLAUDE="$(seat ungated rest 0)" SIGN_ON_GATE="$gate" SIGN_ON_START_TIMEOUT=3 \
  sign-on --as independent --cwd "$work/project" "$prompt"
fails "a gate that does not clear" "$gate" \
  SIGN_ON_CLAUDE="$(seat stuck rest 100)" SIGN_ON_GATE="$gate" \
  sign-on --as independent --cwd "$work/project" "$prompt"

fails "a seat beside a caller in no pane" pane \
  SIGN_ON_CLAUDE="$(seat nowhere rest 0)" sign-on --as independent --beside --cwd "$work/project" "$prompt"
check "and no berth opens for it" false "$(test -f "$work/nowhere/args" && echo true || echo false)"

mkdir -p "$work/home"
fails_to_trust() { # <what> <folder> <environment>...
  local what=$1 folder=$2
  shift 2
  fails "$what" "more than one project" \
    env "$@" SIGN_ON_CLAUDE="$(seat broad rest 0)" sign-on --as independent --cwd "$folder" "$prompt"
}
fails_to_trust "the home folder" "$work/home" HOME="$work/home" CLAUDE_CONFIG_DIR="$work/home"
check "and the config does not trust it" false "$(trusts "$work/home")"
fails_to_trust "the root" / HOME="$work/home" CLAUDE_CONFIG_DIR="$work/home"
check "and no berth opens for either" false "$(test -f "$work/broad/args" && echo true || echo false)"

fails "a launch on a host short of memory" memory \
  SIGN_ON_CLAUDE="$(seat cramped rest 0)" SIGN_ON_MIN_MEMORY=1000000 \
  sign-on --as independent --cwd "$work/project" "$prompt"
check "and no berth opens for it" false "$(test -f "$work/cramped/args" && echo true || echo false)"
SIGN_ON_MIN_MEMORY=1000000 sign-on --as independent --cwd "$work/project" "$prompt" 2>/dev/null
check "a refusal for memory exits with the status that says try again later" 75 "$?"
fails "a memory floor that is not a whole number" SIGN_ON_MIN_MEMORY \
  SIGN_ON_MIN_MEMORY=8GB sign-on --as independent --cwd "$work/project" "$prompt"

fails "a launch with an empty prompt" usage sign-on --as independent --cwd "$work/project" ""
fails "a worker beside its caller" usage \
  BERTH_ID="$opener" sign-on --as worker --beside --cwd "$work/project" "$prompt"
fails "a worker in a tab of its caller's" usage \
  BERTH_ID="$opener" sign-on --as worker --tab --cwd "$work/project" "$prompt"
fails "a seat both beside its caller and in a tab" usage \
  BERTH_ID="$opener" sign-on --as independent --beside --tab --cwd "$work/project" "$prompt"
fails "a launch with two prompts" usage sign-on --as independent --cwd "$work/project" one two
fails "a launch with no working directory" usage sign-on --as independent "$prompt"
fails "an --env that is not an assignment" usage \
  sign-on --as independent --cwd "$work/project" --env SEAT_ROLE "$prompt"
fails "a threshold that is not a whole number" usage \
  sign-on --as independent --cwd "$work/project" --threshold 70% "$prompt"

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failed."
  exit 1
fi
echo "sign-on works."
