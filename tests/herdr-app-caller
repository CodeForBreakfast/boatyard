#!/usr/bin/env bash
# A caller that is not a berth, run from a herdr app terminal, acts on that
# terminal's own yard, and names no backend. See docs/design.md, "The port:
# berth".
#
# Run it under with-herdr-app-yard. It serves a second yard of its own, so
# that the default yard and a named one each hold a terminal with the same
# id, and a caller sent to the wrong yard renames the wrong terminal.
#
# Needs: bash, coreutils, herdr-core, jq, berth.
set -uo pipefail

: "${BERTH_BACKEND:?}"
yard=named
work=$(mktemp -d)
failures=0

check() { # <what> <want> <got>
  if [ "$2" = "$3" ]; then
    echo "ok: $1"
  else
    echo "FAIL: $1: wanted '$2', got '$3'"
    failures=$((failures + 1))
  fi
}

unset BERTH_YARD BERTH_ID
berth serve "$yard" >"$work/serve.log" 2>&1 &
serving=$!
trap 'kill "$serving" 2>/dev/null' EXIT
for _ in $(seq 1 100); do
  berth list "$yard" >/dev/null 2>&1 && break
  sleep 0.1
done

hand() { # <session> <hc arguments>...
  env -u HC_TERMINAL_SOCKET -u HC_TERMINAL_ID HC_SESSION="$1" hc "$2" --json "${@:3}"
}

new_terminal() { # <session>
  hand "$1" run --bg --no-parent --no-notify --cwd "$work" | jq -r .address
}

label() { # <session> <terminal>
  hand "$1" get "$2" | jq -r '.labels["berth.label"] // "none"'
}

# Runs a command in the terminal's own shell, with no backend named and
# nothing else but what herdr-core gave it, and waits for it to finish. Its
# output, errors and exit status land in <name>.out, <name>.err and
# <name>.status.
runs() { # <session> <terminal> <name> <command>
  local _
  hand "$1" send -- "$2" \
    "env -u BERTH_BACKEND $4 >'$work/$3.out' 2>'$work/$3.err'; echo \$? >'$work/$3.status'" >/dev/null
  for _ in $(seq 1 100); do
    [ -s "$work/$3.status" ] && break
    sleep 0.1
  done
}

renames() { # <session> <terminal> <label>
  runs "$1" "$2" "$1-$2-name" "berth name '$3'"
}

default_terminal=$(new_terminal default)
named_terminal=$(new_terminal "$yard")
check "the two yards each hold a terminal with the same id" "$default_terminal" "$named_terminal"

echo "# a caller in a named yard"

renames "$yard" "$named_terminal" "named caller"
check "it acts on its own yard" "named caller" "$(label "$yard" "$named_terminal")"
check "it leaves the default yard's terminal alone" none "$(label default "$default_terminal")"

echo "# a caller in the default yard"

renames default "$default_terminal" "default caller"
check "it acts on its own yard" "default caller" "$(label default "$default_terminal")"
check "it leaves the named yard's terminal alone" "named caller" "$(label "$yard" "$named_terminal")"

echo "# a caller that asks for its own id"

runs "$yard" "$named_terminal" id "berth id"
check "it is given its own terminal" "$named_terminal" "$(cat "$work/id.out")"

echo "# a caller sent to a yard it is not in"

runs "$yard" "$named_terminal" elsewhere "BERTH_YARD=default berth open --as worker --cwd '$work' -- true"
check "it is refused" true "$([ "$(cat "$work/elsewhere.status")" != 0 ] && echo true || echo false)"
check "the reason names both yards" true \
  "$(grep -q "$yard" "$work/elsewhere.err" && grep -q default "$work/elsewhere.err" && echo true || echo false)"
check "the reason does not call the caller gone" false \
  "$(grep -q gone "$work/elsewhere.err" && echo true || echo false)"

berth stop "$yard"
wait "$serving"
trap - EXIT

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failed."
  exit 1
fi
echo "A caller outside a berth acts on its own yard."
