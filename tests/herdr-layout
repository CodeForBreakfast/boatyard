#!/usr/bin/env bash
# The herdr adapter's layout rules, which the port contract leaves to each
# adapter. See docs/design.md, "The herdr adapter".
#
# Run it under with-herdr-yard.
#
# Needs: bash, coreutils, herdr, jq, berth.
set -uo pipefail

work=$(mktemp -d)
failures=0

check() { # <what> <want> <got>
  if [ "$2" = "$3" ]; then
    echo "ok: $1"
  else
    echo "FAIL: $1: wanted '$2', got '$3'"
    failures=$((failures + 1))
  fi
}

pane() { # <id> <field>
  herdr --session "$BERTH_YARD" pane get "$1" | jq -r ".result.pane.$2"
}

workspace_label() { # <workspace id>
  herdr --session "$BERTH_YARD" workspace get "$1" | jq -r .result.workspace.label
}

echo "# an independent berth becomes a workspace"

first=$(berth open --as independent --cwd "$work" --label "first line" -- true)
second=$(berth open --as independent --cwd "$work" -- true)
workspace=$(pane "$first" workspace_id)
check "each independent berth has its own workspace" false \
  "$([ "$workspace" = "$(pane "$second" workspace_id)" ] && echo true || echo false)"
check "the workspace takes the berth's label" "first line" "$(workspace_label "$workspace")"
berth name "$first" "renamed line"
check "naming the berth names its workspace" "renamed line" "$(workspace_label "$workspace")"

echo "# workers share a tab in their opener's workspace"

workers=()
for _ in 1 2; do
  workers+=("$(BERTH_ID=$first berth open --as worker --cwd "$work" -- true)")
done
tab=$(pane "${workers[0]}" tab_id)
check "a worker opens in its opener's workspace" "$workspace" "$(pane "${workers[0]}" workspace_id)"
check "a worker opens outside its opener's tab" false \
  "$([ "$tab" = "$(pane "$first" tab_id)" ] && echo true || echo false)"
for worker in "${workers[@]:1}"; do
  check "worker $worker shares the first worker's tab" "$tab" "$(pane "$worker" tab_id)"
done
check "the workers' tab is labelled for them" workers \
  "$(herdr --session "$BERTH_YARD" tab get "$tab" | jq -r .result.tab.label)"

echo "# workers fill a tab, then open another"

for _ in 1 2 3 4 5; do
  workers+=("$(BERTH_ID=$first berth open --as worker --cwd "$work" -- true)")
done
worker_tabs=$(for worker in "${workers[@]}"; do pane "$worker" tab_id; done | sort -u)
check "the workers fill more than one tab" true "$([ "$(wc -l <<<"$worker_tabs")" -gt 1 ] && echo true || echo false)"
for worker_tab in $worker_tabs; do
  check "the workers' tab $worker_tab is labelled for them" workers \
    "$(herdr --session "$BERTH_YARD" tab get "$worker_tab" | jq -r .result.tab.label)"
  smallest=$(herdr --session "$BERTH_YARD" pane layout --pane "$(herdr --session "$BERTH_YARD" pane list |
    jq -r --arg tab "$worker_tab" 'first(.result.panes[] | select(.tab_id == $tab)) | .pane_id')" |
    jq -c '.result.layout.panes | {rows: (map(.rect.height) | min), cols: (map(.rect.width) | min)}')
  # A pane's rect holds two rows that its terminal does not get.
  check "every worker in tab $worker_tab keeps 12 rows or more" true \
    "$(jq '.rows - 2 >= 12' <<<"$smallest")"
  check "every worker in tab $worker_tab keeps 80 columns or more" true \
    "$(jq '.cols >= 80' <<<"$smallest")"
done

echo "# a tender splits beside its opener"

tender=$(BERTH_ID=$first berth open --as tender --cwd "$work" -- true)
check "a tender opens in its opener's tab" "$(pane "$first" tab_id)" "$(pane "$tender" tab_id)"

echo "# a labelled tender opens once in a workspace"

viewer=$(BERTH_ID=$first berth open --as tender --cwd "$work" --label "a view" -- true)
# A steward started again by hand, in a new pane of the old workspace.
restarted=$(herdr --session "$BERTH_YARD" pane split "$first" --direction right --no-focus |
  jq -r .result.pane.pane_id)
check "a pane opened by hand in the workspace gives the open tender" "$viewer" \
  "$(env -u BERTH_ID HERDR_PANE_ID="$restarted" berth open --as tender --cwd "$work" --label "a view" -- true)"
herdr --session "$BERTH_YARD" pane close "$restarted" >/dev/null

echo "# the cascade takes the whole workspace"

by_hand=$(herdr --session "$BERTH_YARD" pane split "$first" --direction right --no-focus |
  jq -r .result.pane.pane_id)
berth close "$first"
check "the workspace is gone" workspace_not_found \
  "$(herdr --session "$BERTH_YARD" workspace get "$workspace" 2>&1 | jq -r .error.code)"
check "a pane opened by hand in it is gone" pane_not_found \
  "$(herdr --session "$BERTH_YARD" pane get "$by_hand" 2>&1 | jq -r .error.code)"
check "the other independent berth stays" "$second" "$(berth list | jq -r '.[].id')"

exists() { # <pane id>
  herdr --session "$BERTH_YARD" pane get "$1" >/dev/null 2>&1 && echo true || echo false
}

echo "# a seat a person works in starts an effort beside itself"

# A pane a person opened by hand is not a berth, so berth knows it only from
# herdr's own variables.
seat=$(herdr --session "$BERTH_YARD" workspace create --cwd "$work" --label "a person's seat" --no-focus |
  jq -r .result.root_pane.pane_id)
steward=$(HERDR_PANE_ID=$seat berth open --as independent --beside --cwd "$work" -- true)
check "it splits the seat's tab" "$(pane "$seat" tab_id)" "$(pane "$steward" tab_id)"
steward_worker=$(BERTH_ID=$steward berth open --as worker --cwd "$work" -- true)
check "its workers share the seat's workspace" "$(pane "$seat" workspace_id)" "$(pane "$steward_worker" workspace_id)"
berth close "$steward"
check "closing it leaves the seat" true "$(exists "$seat")"
check "closing it closes its workers" false "$(exists "$steward_worker")"

# A seat that sign-on started is a berth with a workspace of its own.
seat=$(berth open --as independent --cwd "$work" -- true)
steward=$(BERTH_ID=$seat berth open --as independent --beside --cwd "$work" -- true)
check "beside a berth, it splits the berth's tab" "$(pane "$seat" tab_id)" "$(pane "$steward" tab_id)"
berth name "$steward" "the effort"
check "naming it leaves the seat's workspace label" "$(workspace_label "$(pane "$seat" workspace_id)")" \
  "$(workspace_label "$(pane "$steward" workspace_id)")"
berth close "$seat"
check "closing the seat leaves it" true "$(exists "$steward")"
berth close "$steward"

echo "# a seat starts an effort in a tab of its own workspace"

seat=$(berth open --as independent --cwd "$work" --label "the seat" -- true)
steward=$(BERTH_ID=$seat berth open --as independent --tab --cwd "$work" --label effort -- true)
check "it opens in the seat's workspace" "$(pane "$seat" workspace_id)" "$(pane "$steward" workspace_id)"
check "it opens outside the seat's tab" false \
  "$([ "$(pane "$seat" tab_id)" = "$(pane "$steward" tab_id)" ] && echo true || echo false)"
check "its tab takes its label" effort \
  "$(herdr --session "$BERTH_YARD" tab get "$(pane "$steward" tab_id)" | jq -r .result.tab.label)"
berth name "$steward" "renamed effort"
check "naming it names its tab" "renamed effort" \
  "$(herdr --session "$BERTH_YARD" tab get "$(pane "$steward" tab_id)" | jq -r .result.tab.label)"
check "naming it leaves the seat's workspace label" "the seat" \
  "$(workspace_label "$(pane "$seat" workspace_id)")"
steward_tab=$(pane "$steward" tab_id)
berth close "$steward"
check "closing it closes its tab" tab_not_found \
  "$(herdr --session "$BERTH_YARD" tab get "$steward_tab" 2>&1 | jq -r .error.code)"
check "closing it leaves the seat" true "$(exists "$seat")"
steward=$(BERTH_ID=$seat berth open --as independent --tab --cwd "$work" -- true)
berth close "$seat"
check "closing the seat leaves it" true "$(exists "$steward")"
berth close "$steward"

echo "# a concierge starts an effort apart from itself"

concierge=$(berth open --as independent --cwd "$work" --label concierge -- true)
steward=$(BERTH_ID=$concierge berth open --as independent --cwd "$work" --label effort -- true)
check "it opens a workspace of its own" false \
  "$([ "$(pane "$concierge" workspace_id)" = "$(pane "$steward" workspace_id)" ] && echo true || echo false)"
check "the concierge's workspace keeps its label" concierge \
  "$(workspace_label "$(pane "$concierge" workspace_id)")"
berth close "$steward"
check "closing it leaves the concierge" true "$(exists "$concierge")"
berth close "$concierge"

echo "# a berth takes focus only when asked to"

landed=$(berth open --as independent --focus --cwd "$work" -- true)
check "an independent berth opened with --focus has focus" true "$(pane "$landed" focused)"
behind=$(BERTH_ID=$landed berth open --as worker --cwd "$work" -- true)
check "a berth opened without --focus does not have focus" false "$(pane "$behind" focused)"
check "a berth opened without --focus leaves focus where it was" true "$(pane "$landed" focused)"
for as in worker tender; do
  beside=$(BERTH_ID=$landed berth open --as "$as" --focus --cwd "$work" -- true)
  check "a $as opened with --focus has focus" true "$(pane "$beside" focused)"
done

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failed."
  exit 1
fi
echo "The herdr layout rules hold."
