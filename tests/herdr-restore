#!/usr/bin/env bash
# The herdr adapter brings its berths back whole after herdr restores a yard.
# See docs/design.md, "The herdr adapter".
#
# The yard's server is stopped and started again, which is when herdr
# restores a session. The server this suite starts is stopped by the pid it
# was started with, and by nothing else.
#
# Run it under with-herdr-yard.
#
# Needs: bash, coreutils, herdr, jq, berth.
set -uo pipefail

work=$(mktemp -d)
failures=0

check() { # <what> <want> <got>
  if [ "$2" = "$3" ]; then
    echo "ok: $1"
  else
    echo "FAIL: $1: wanted '$2', got '$3'"
    failures=$((failures + 1))
  fi
}

herdr_yard() {
  herdr --session "$BERTH_YARD" "$@"
}

berths() {
  berth list | jq -c 'map({id, label, relationship, parent}) | sort_by(.id)'
}

# The port does not list a berth's place, so it is read from herdr.
places() {
  herdr_yard pane list | jq -c '[.result.panes[] | {id: .pane_id, place: .tokens.berth_place}] | sort_by(.id)'
}

# The viewer counts its starts, so a start shows whatever the screen holds.
viewer_runs() {
  wc -l <"$work/viewer-runs" 2>/dev/null || echo 0
}

runs_settle() { # <what> <want>
  local got _
  for _ in $(seq 1 100); do
    got=$(viewer_runs)
    [ "$got" = "$2" ] && break
    sleep 0.1
  done
  check "$1" "$2" "$got"
}

open_viewer() { # <opener>
  BERTH_ID=$1 berth open --as tender --cwd "$work" --label viewer -- \
    bash -c "echo run >>$(printf '%q' "$work/viewer-runs"); exec sleep 600"
}

line=$(berth open --as independent --cwd "$work" --label line -- sleep 600)
worker=$(BERTH_ID=$line berth open --as worker --cwd "$work" --label worker -- sleep 600)
viewer=$(open_viewer "$line")
runs_settle "the viewer starts its command" 1
check "a viewer whose command runs is adopted" "$viewer" "$(open_viewer "$line")"
runs_settle "an adopted viewer whose command runs is not started again" 1

before=$(berths)
places_before=$(places)
check "the yard holds three berths before the restore" 3 "$(jq length <<<"$before")"

echo "# herdr restores the yard"

berth stop "$BERTH_YARD"
herdr server >"$HOME/restored-server.log" 2>&1 &
server=$!
stop_server() {
  kill "$server" 2>/dev/null || true
  wait "$server" 2>/dev/null || true
}
trap stop_server EXIT
until herdr status server --json | jq -e .running >/dev/null; do
  if ! kill -0 "$server" 2>/dev/null || [ "$SECONDS" -gt 60 ]; then
    echo "the herdr server did not come back."
    cat "$HOME/restored-server.log"
    exit 1
  fi
  sleep 0.1
done

check "berth lists every berth with its id, label, relationship and parent" "$before" "$(berths)"
check "every berth keeps its place" "$places_before" "$(places)"

check "a restored viewer is adopted by its label" "$viewer" "$(open_viewer "$line")"
check "no second viewer opens" "$before" "$(berths)"
runs_settle "an adopted viewer whose command had stopped starts it again" 2

for id in "$viewer" "$worker" "$line"; do
  berth close "$id"
done

echo
if [ "$failures" -gt 0 ]; then
  echo "$failures failed."
  exit 1
fi
echo "The herdr adapter brings its berths back whole after a restore."
