#!/usr/bin/env bash
# berth's front end: --help and -h print the usage and change nothing, and a
# label never starts with a dash. It runs against an adapter that records
# every call, so it needs no backend. See docs/design.md, "The port: berth".
#
# Run it with the path of the berth script, bin/berth, as its argument.
#
# Needs: bash, coreutils.
set -uo pipefail

work=$(mktemp -d)
failures=0
calls="$work/calls"

cp "${1:?}" "$work/berth"
{
  echo "#!$BASH"
  echo "echo \"\$*\" >>'$calls'"
} >"$work/berth-recorder"
chmod +x "$work/berth-recorder"

check() { # <what> <want> <got>
  if [ "$2" = "$3" ]; then
    echo "ok: $1"
  else
    echo "FAIL: $1: wanted '$2', got '$3'"
    failures=$((failures + 1))
  fi
}

reached_adapter() {
  [ -s "$calls" ] && echo true || echo false
}

prints_usage() { # <what> <command>...
  local what=$1 out status
  shift
  : >"$calls"
  out=$("$@" 2>&1)
  status=$?
  check "$what: succeeds" 0 "$status"
  check "$what: prints the usage" true "$(case $out in usage:*) echo true ;; *) echo false ;; esac)"
  check "$what: reaches no adapter" false "$(reached_adapter)"
}

refuses() { # <what> <command>...
  local what=$1 err
  shift
  : >"$calls"
  if err=$("$@" 2>&1 >/dev/null); then
    echo "FAIL: $what: it succeeded"
    failures=$((failures + 1))
  else
    check "$what: gives a reason" true "$([ -n "$err" ] && echo true || echo false)"
  fi
  check "$what: reaches no adapter" false "$(reached_adapter)"
}

export BERTH_BACKEND=recorder BERTH_ID=any-berth
berth=(bash "$work/berth")

prints_usage "berth --help" "${berth[@]}" --help
prints_usage "berth -h" "${berth[@]}" -h
for verb in serve stop yard yards id open name status list send-text send-key wait-text read state agent-state close; do
  prints_usage "berth $verb --help" "${berth[@]}" "$verb" --help
  prints_usage "berth $verb -h" "${berth[@]}" "$verb" -h
done
prints_usage "berth name --help with no backend named" env -u BERTH_BACKEND "${berth[@]}" name --help

refuses "yards takes no argument" "${berth[@]}" yards some-yard
refuses "list refuses an option it does not know" "${berth[@]}" list --every

passes() { # <what> <want> <command>...
  local what=$1 want=$2
  shift 2
  : >"$calls"
  "$@"
  check "$what" "$want" "$(cat "$calls")"
}

passes "list passes the caller's yard and berths only" "list  berths" "${berth[@]}" list
passes "list --all before a yard passes both" "list some-yard all" "${berth[@]}" list --all some-yard
passes "list --all after a yard passes both" "list some-yard all" "${berth[@]}" list some-yard --all
passes "yards reaches the adapter" "yards" "${berth[@]}" yards

refuses "name refuses a label that starts with a dash" "${berth[@]}" name --verbose
refuses "name refuses a dashed label for a named berth" "${berth[@]}" name some-berth -x

: >"$calls"
"${berth[@]}" name some-berth "a plain label"
check "name still sets a plain label" "name some-berth a plain label" "$(cat "$calls")"

passes "status sets a named berth's text" "status some-berth drafting the plan" \
  "${berth[@]}" status some-berth "drafting the plan"
passes "status with no id sets the calling berth's text" "status any-berth drafting the plan" \
  "${berth[@]}" status "drafting the plan"
passes "status --clear passes an empty text" "status some-berth " "${berth[@]}" status some-berth --clear
passes "status --clear with no id clears the calling berth's text" "status any-berth " \
  "${berth[@]}" status --clear
refuses "status needs a text" "${berth[@]}" status
refuses "status refuses an empty text" "${berth[@]}" status some-berth ""
refuses "status refuses a text that starts with a dash" "${berth[@]}" status --verbose
refuses "status refuses a dashed text for a named berth" "${berth[@]}" status some-berth -x
refuses "status refuses a berth that starts with a dash" "${berth[@]}" status --clear some-berth

# A host such as one running herdr and the herdr app side by side names no
# backend, and the calling pane's variables choose it.
for backend in herdr herdr-app; do
  {
    echo "#!$BASH"
    echo "echo \"$backend \$*\" >>'$calls'"
  } >"$work/berth-$backend"
  chmod +x "$work/berth-$backend"
done
unset BERTH_BACKEND HC_TERMINAL_ID HERDR_PANE_ID

passes "BERTH_BACKEND wins over the calling pane" "yard" \
  env BERTH_BACKEND=recorder HC_TERMINAL_ID=t1 HERDR_PANE_ID=p1 "${berth[@]}" yard
passes "a caller in a herdr app terminal reaches the app's adapter" "herdr-app yard" \
  env HC_TERMINAL_ID=t1 "${berth[@]}" yard
passes "a caller in a herdr pane reaches herdr's adapter" "herdr yard" \
  env HERDR_PANE_ID=p1 "${berth[@]}" yard
refuses "a caller in both a herdr pane and an app terminal is refused" \
  env HC_TERMINAL_ID=t1 HERDR_PANE_ID=p1 "${berth[@]}" yard
refuses "a caller in neither is refused" "${berth[@]}" yard

err=$(env HC_TERMINAL_ID=t1 HERDR_PANE_ID=p1 "${berth[@]}" yard 2>&1)
check "the refusal of a caller in both says so" true \
  "$(case $err in *both*) echo true ;; *) echo false ;; esac)"
err=$("${berth[@]}" yard 2>&1)
check "the refusal of a caller in neither says so" true \
  "$(case $err in *" no herdr pane or herdr app terminal"*) echo true ;; *) echo false ;; esac)"

rm -rf "$work"
exit $((failures > 0))
