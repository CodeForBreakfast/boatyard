#!/usr/bin/env bash
# bilge-pump's tests: the compaction decision, the statusline tap, and the
# compactor itself. See docs/design.md, "bilge-pump".
#
# The compactor runs against a stand-in berth that answers `berth state` from
# a file and records what is typed into it, so that it needs no backend.
#
# Run it with bilge-pump, bilge-pump-tap and bilge-pump-decide on the path,
# and no berth.
#
# Needs: bash, coreutils, jq.
set -uo pipefail

work=$(mktemp -d)
failures=0

check() { # <what> <want> <got>
  if [ "$2" = "$3" ]; then
    echo "ok: $1"
  else
    echo "FAIL: $1: wanted '$2', got '$3'"
    failures=$((failures + 1))
  fi
}

# Waits up to ten seconds for a command to succeed.
eventually() { # <command>...
  local _
  for _ in $(seq 1 100); do
    "$@" && return 0
    sleep 0.1
  done
  return 1
}

export BILGE_PUMP_STATE_DIR="$work/state"
yard=testyard

# --- the decision ---

decides() { # <want> <state> <free> <since fire> <threshold> <cooldown>
  local want=$1
  shift
  check "decide $*" "$want" "$(bilge-pump-decide "$@")"
}

decides fire at-rest 50 1000 80 300
decides skip:not-at-rest active 50 1000 80 300
decides skip:not-at-rest blocked 50 1000 80 300
decides skip:not-at-rest gone 50 1000 80 300
decides skip:no-figure at-rest "" 1000 80 300
decides skip:no-figure at-rest 5x 1000 80 300
decides skip:threshold at-rest 80 1000 80 300
decides fire at-rest 79 1000 80 300
decides skip:cooldown at-rest 50 299 80 300
decides fire at-rest 50 300 80 300

# --- the tap ---

statusline="$work/statusline.json"
printf '{"context_window":{"remaining_percentage":42.7}}\n\n' >"$statusline"
tapped="$BILGE_PUMP_STATE_DIR/$yard/tapped/context"

BERTH_YARD=$yard BERTH_ID=tapped bilge-pump-tap cat <"$statusline" >"$work/passed"
check "the tap passes its input on unchanged" true \
  "$(cmp -s "$statusline" "$work/passed" && echo true || echo false)"
check "the tap records the free context, keyed by yard and berth" 42 "$(cat "$tapped" 2>/dev/null)"

BERTH_YARD=$yard BERTH_ID=tapped bilge-pump-tap sh -c 'cat >/dev/null; exit 3' <"$statusline"
check "the tap passes on the command's exit status" 3 $?

check "the tap prints nothing when given no command" "" \
  "$(BERTH_YARD=$yard BERTH_ID=tapped bilge-pump-tap <"$statusline")"

echo '{"context_window":{"remaining_percentage":null}}' |
  BERTH_YARD=$yard BERTH_ID=tapped bilge-pump-tap cat >/dev/null
check "an input without a figure removes the record" false \
  "$([ -e "$tapped" ] && echo true || echo false)"

(unset BERTH_YARD BERTH_ID && bilge-pump-tap cat <"$statusline" >/dev/null)
check "outside a berth the tap records nothing" "tapped" "$(ls "$BILGE_PUMP_STATE_DIR/$yard")"

# --- the compactor ---

# Without berth on the path, and with bash as the only thing that is.
mkdir "$work/only-bash"
ln -s "$(command -v bash)" "$work/only-bash/bash"
err=$(PATH="$work/only-bash" BERTH_YARD=$yard "$(command -v bilge-pump)" nowhere 2>&1)
check "without berth it refuses to start" 1 $?
check "and says berth is missing" true "$([[ $err == *"berth is not on the path"* ]] && echo true || echo false)"

stub="$work/stub"
mkdir -p "$stub" "$work/bin"
{
  echo "#!$(command -v bash)"
  cat <<'EOF'
case "$1" in
  state) cat "$STUB/$2.state" ;;
  send-text | send-key) echo "$*" >>"$STUB/$2.typed" ;;
  *) exit 1 ;;
esac
EOF
} >"$work/bin/berth"
chmod +x "$work/bin/berth"
export PATH="$work/bin:$PATH" STUB="$stub" BERTH_YARD=$yard
unset BERTH_ID

pid_of() { cat "$BILGE_PUMP_STATE_DIR/$yard/$1/pid" 2>/dev/null; }
pumping() { [ -n "$(pid_of "$1")" ] && kill -0 "$(pid_of "$1")" 2>/dev/null; }
stop_pumps() {
  local file
  for file in "$BILGE_PUMP_STATE_DIR/$yard"/*/pid; do
    [ -f "$file" ] && kill "$(cat "$file")" 2>/dev/null
  done
}
trap stop_pumps EXIT
typed() { cat "$stub/$1.typed" 2>/dev/null; }

# A berth at rest with no figure.
echo at-rest >"$stub/bare.state"
began=$SECONDS
bilge-pump bare --tick 1
check "it starts" 0 $?
check "and returns at once" true "$([ $((SECONDS - began)) -le 2 ] && echo true || echo false)"
check "leaving a compactor running" true "$(eventually pumping bare && echo true || echo false)"

session() { awk '{ print $4 }' <<<"$(sed 's/^.*) //' "/proc/$1/stat")"; }
if [ -r /proc/self/stat ]; then
  check "in a session of its own" true \
    "$([ "$(session "$(pid_of bare)")" = "$(pid_of bare)" ] && echo true || echo false)"
fi

first=$(pid_of bare)
err=$(bilge-pump bare --tick 1 2>&1)
check "a second compactor on the same berth refuses to start" 1 $?
check "and names the one that runs" true "$([[ $err == *"$first"* ]] && echo true || echo false)"
check "and leaves the first in place" "$first" "$(pid_of bare)"

heartbeat="$BILGE_PUMP_STATE_DIR/$yard/bare/heartbeat"
eventually test -f "$heartbeat"
beat=$(cat "$heartbeat" 2>/dev/null)
check "the heartbeat holds the state, the figure, the threshold and the yard" \
  "at-rest - 70 $yard" "${beat#* }"
changed() { [ "$(cat "$heartbeat" 2>/dev/null)" != "$beat" ]; }
check "the heartbeat is rewritten every tick" true "$(eventually changed && echo true || echo false)"
sleep 2
check "a berth with no figure is never compacted" "" "$(typed bare)"
check "and says so in the log once" 1 \
  "$(grep -c "$yard bare no-figure" "$BILGE_PUMP_STATE_DIR/bilge-pump.log")"

# A berth at rest and low on context.
echo at-rest >"$stub/low.state"
mkdir -p "$BILGE_PUMP_STATE_DIR/$yard/low"
echo 50 >"$BILGE_PUMP_STATE_DIR/$yard/low/context"
bilge-pump low --tick 1 --threshold 80 --cooldown 3600
fired() { [ "$(typed low | wc -l)" -ge 3 ]; }
eventually fired
check "a berth at rest below the threshold is sent the compact command" \
  "send-text low /compact
send-key low Enter
send-key low Enter" "$(typed low)"
sleep 2
check "and not again inside the cooldown" 3 "$(typed low | wc -l)"

# The threshold comes from the flag, then the environment, then the default.
threshold_beat() { # <berth>
  eventually test -f "$BILGE_PUMP_STATE_DIR/$yard/$1/heartbeat"
  cut -d' ' -f4 "$BILGE_PUMP_STATE_DIR/$yard/$1/heartbeat" 2>/dev/null
}
echo at-rest >"$stub/env.state"
BILGE_PUMP_THRESHOLD=55 bilge-pump env --tick 1
check "the variable sets the threshold" 55 "$(threshold_beat env)"
echo at-rest >"$stub/flag.state"
BILGE_PUMP_THRESHOLD=55 bilge-pump flag --tick 1 --threshold 40
check "the flag overrides the variable" 40 "$(threshold_beat flag)"
err=$(BILGE_PUMP_THRESHOLD=5x bilge-pump bad --tick 1 2>&1)
check "a variable that is not a whole number is refused" 2 $?
check "and the usage names the variable" true \
  "$([[ $err == *BILGE_PUMP_THRESHOLD* ]] && echo true || echo false)"

# A stale pid file does not stop a start.
sleep 0 &
dead=$!
wait "$dead"
echo at-rest >"$stub/stale.state"
mkdir -p "$BILGE_PUMP_STATE_DIR/$yard/stale"
echo "$dead" >"$BILGE_PUMP_STATE_DIR/$yard/stale/pid"
bilge-pump stale --tick 1
check "a pid file naming a dead process does not stop a start" 0 $?

# A berth that goes.
pid=$(pid_of bare)
echo gone >"$stub/bare.state"
exited() { ! kill -0 "$pid" 2>/dev/null; }
check "the compactor exits when its berth is gone" true "$(eventually exited && echo true || echo false)"
check "and clears its files" false \
  "$([ -e "$BILGE_PUMP_STATE_DIR/$yard/bare" ] && echo true || echo false)"

if [ "$failures" -gt 0 ]; then
  cat "$BILGE_PUMP_STATE_DIR/bilge-pump.log"
  echo "$failures failed"
  exit 1
fi
echo "all passed"
