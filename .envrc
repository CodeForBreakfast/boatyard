# An untracked `.envrc.local` can select another dev shell with
# `devshell=<name>`, and an untracked `.env.local` supplies its environment.
#
# Both files are gitignored, so they exist only in the main checkout. A
# worktree resolves the main checkout's copy first, then its own.
main_checkout="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")"

dotenv_if_exists "$main_checkout/.env.local"
dotenv_if_exists .env.local

source_env_if_exists "$main_checkout/.envrc.local"
source_env_if_exists .envrc.local

# One `use flake`, here, on the shell those files chose. nix-direnv deletes
# every profile in `.direnv` before writing its own, so a second call evicts
# the first and both rebuild on every load.
use flake ".#${devshell:-default}"
